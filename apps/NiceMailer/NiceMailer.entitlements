<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of NiceMailer.app, applied by scripts/make-bundle.sh when it
  signs the app (docs/app-bundle.md, "Signature").

  The app is signed with the hardened runtime, which notarization requires.
  Under the hardened runtime, the protected resources a program may ask for
  must be declared here: without the address book entitlement, macOS refuses
  the Contacts without even asking the user (AddressBook.swift,
  docs/geek-ui.md, "Senders in the address book").

  Nothing else is declared: no JIT, no unsigned memory, no library
  validation exception. The editor's WebKit runs in WebKit's own processes,
  which need no entitlement from the app. The core and the CLI
  (Contents/Helpers) need none at all.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.personal-information.addressbook</key>
  <true/>
</dict>
</plist>
