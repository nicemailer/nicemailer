# Simplified display of a thread: folded messages, hidden quotes and
# signatures, T (show all), clicks on headers and on "···" lines.
key @
type fixture
key ret
key ;
key a
key j
key j
key j
expect selected_subject = Chantier
# Only the latest message (Bob, who only quotes) is open.
expect reader_folded = 3
expect reader_text ~ only quotes earlier messages
expect reader_text ~ quoted lines
expect reader_text !~ not in this conversation
expect reader_text !~ Atelier Dupuis
snap simplified
# T shows everything, T again simplifies.
key T
expect show_all = true
expect reader_folded = 0
expect reader_text ~ Atelier Dupuis
expect reader_text ~ Envoyé de mon iPhone
expect reader_text ~ Parfait, à jeudi
snap show-all
key T
expect show_all = false
expect reader_folded = 3
# A click on the first header unfolds that message: its text shows, its
# signature stays hidden behind a "···" line.
click reader-link:0
expect reader_folded = 2
expect reader_text ~ Peux-tu passer jeudi
expect reader_text ~ ··· signature
expect reader_text !~ Atelier Dupuis
# The second link is now that signature line: a click shows it.
click reader-link:1
expect reader_text ~ Atelier Dupuis
snap revealed
# Folding the message again with a click on its header.
click reader-link:0
expect reader_folded = 3
# One line per message: the arrow (a conversation), the name, the date,
# then the sender's domain on the folded lines, its address in full on an
# unfolded one (only Bob's now). A click copies it; ⌘-click filters the
# list on it.
expect reader_text ~ ▸ Alice · 30 Oct at 11:00 · @example.org
expect reader_text ~ ▾ Bob · 30 Oct at 14:00 · bob@example.org
snap sender
click reader-sender:0
expect pasteboard = bob@example.org
expect flash ~ Copied: bob@example.org
click reader-sender:0 cmd
expect filters ~ bob@example.org
expect flash ~ Mails from bob@example.org
key esc
expect filters = 
# ctrl-k / ctrl-j: up and down the conversation, one message open at a
# time. The last header clicked was the first message's: nothing above it.
key ctrl-k
expect flash ~ First message of the conversation
key ctrl-j
expect reader_text ~ ▾ me@example.com
expect reader_text ~ ▸ Alice · 30 Oct at 11:00
key ctrl-j
expect reader_text ~ ▾ Alice · 30 Oct at 13:00
expect reader_text ~ ▸ me@example.com
key ctrl-j
key ctrl-j
expect flash ~ Last message of the conversation
expect reader_text ~ ▾ Bob
# sp / si: the PDF of the message the reader is on, so that a whole
# conversation can be printed mail by mail. On Bob's (the latest): "Re
# Chantier"; up to Alice's first mail: "Chantier", without "Re".
key s
key p
expect flash ~ Re Chantier.pdf
key ctrl-k
key ctrl-k
key ctrl-k
expect reader_text ~ ▾ Alice · 30 Oct at 11:00
key s
key i
expect flash ~ Chantier.pdf
expect flash !~ Re Chantier
key s
key p
expect flash ~ Chantier (2).pdf
expect flash !~ Re Chantier
expect export_files = 3
# The other rows of s take the same message: the clipboard and the .eml.
key s
key c
expect pasteboard ~ Subject: Chantier
expect pasteboard !~ Subject: Re:
key s
key e
expect flash ~ Chantier.eml
expect flash !~ Re Chantier
expect export_files = 4
