# The Appearance tab of the Preferences (docs/themes.md, "Choosing a
# theme"): the themes the core lists, the one chosen marked; a click
# chooses another, written in config.toml and applied at once; the button
# opens the folder of the themes (recorded, nothing is opened).
preferences appearance
expect prefs_themes = *geek,clean,regular,minimal
snap appearance
click prefs:theme-regular
expect prefs_theme_error =
expect prefs_themes = geek,clean,*regular,minimal
expect theme = regular
click prefs:themes-folder
expect opened_file = themes
# minimal, built in as the others.
click prefs:theme-minimal
expect prefs_themes = geek,clean,regular,*minimal
expect theme = minimal
# Back to geek through clean: the menus drop from their blocks of the
# status bar, not from where the blocks of the previous theme were.
click prefs:theme-clean
expect theme = clean
click prefs:theme-geek
expect theme = geek
preferences close
expect theme = geek
key ;
expect menu_under_block = true
key esc
key v
expect menu_under_block = true
key esc
