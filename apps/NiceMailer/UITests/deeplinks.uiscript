# Deep links (docs/deep-links.md): each mail has its URL,
# nicemailer://m/<key>, 12 hexadecimal characters that depend only on the
# mail (its Message-ID), not on the database. The first row of `l` copies
# it as a Markdown link
# (Return) or a bare URL (⌘-Return), to the private pasteboard; `openurl`
# gives a URL to the app as macOS would.

# The newsletter, in the Archive of the fixture account.
key @
type fixture
key ret
key ;
key a
expect selected_subject = La lettre de novembre
key l
expect picker_first = Link to this mail
expect picker_first_detail ~ nicemailer://m/
snap deeplink-row
key ret
expect overlay = none
expect pasteboard ~ [La lettre de novembre](nicemailer://m/
expect flash ~ Markdown link copied
key l
key cmd-ret
expect pasteboard ~ nicemailer://m/
expect pasteboard !~ [

# Elsewhere (the Inbox, another mail, a panel open), the link brings the
# mail back, in its folder.
key ;
key i
expect selected_subject != La lettre de novembre
key ?
expect overlay = help
openurl clipboard
expect selected_subject = La lettre de novembre
expect folder = Archive
expect overlay = none

# In one column, the mail fills the window, as after Return.
key v
key 1
expect columns = 1
key esc
key ;
key i
openurl clipboard
expect selected_subject = La lettre de novembre
expect reading = true
key esc
key v
key 2

# In a conversation, the link names the message the reader is on: up
# "Chantier" with ctrl-k, to my reply (the 2nd of 4), the link is that
# message's. Opened from elsewhere, the reader shows that very message,
# unfolded, and ctrl-j goes on from it.
key ;
key a
key j
key j
key j
expect selected_subject = Chantier
key ctrl-k
key ctrl-k
expect reader_current = 2
expect reader_text ~ ▾ me@example.com
key l
key cmd-ret
expect pasteboard ~ nicemailer://m/
# Down to the latest before leaving: the reader keeps its place in each
# conversation, so the link must bring the 2nd back by itself.
key ctrl-j
key ctrl-j
expect reader_current = 4
key ;
key i
expect selected_subject != Chantier
openurl clipboard
expect selected_subject = Chantier
# My reply is in Sent, but the conversation is filed in Archive: shown there.
expect folder = Archive
expect reader_current = 2
expect reader_text ~ ▾ me@example.com
snap deeplink-message
key ctrl-j
expect reader_current = 3

# A link to a mail no longer there (an old link, by id), a key this Mac
# has no mail for, and a URL that is no mail link.
openurl nicemailer://m/999999999
expect error ~ no longer in NiceMailer
openurl nicemailer://m/000000000000
expect error ~ not in NiceMailer on this Mac
openurl nicemailer://x/1
expect error ~ Not a link to a NiceMailer mail
