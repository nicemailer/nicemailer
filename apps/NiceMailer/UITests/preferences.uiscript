# The Preferences (Settings…, ⌘,): the accounts in display order, moved
# with the buttons; a new account added from its three fields, then only
# what the attempt asks for, and always "On the server" before anything is
# written; an account only looked at, organized later. The creation methods are answered by
# `UIScriptSetupCore`: no DNS, no mail server, nothing written to
# accounts.toml (docs/accounts.md, "In the app").

preferences
expect prefs_accounts = perso,fixture
expect prefs_selection = perso
snap preferences-list

# The order, with the buttons under the list (the same as a drag).
click prefs:account-fixture
expect prefs_selection = fixture
click prefs:up
expect prefs_accounts = fixture,perso
click prefs:down
expect prefs_accounts = perso,fixture

# A domain whose MX is not known: the IMAP server is asked, with why.
click prefs:plus
expect prefs_selection = add
# The letters that are commands in the main window are text here: `f` opens
# no search, `d` archives nothing, `;` and `?` open nothing.
click prefs:email
type fdjk;?
expect setup_email = fdjk;?
expect overlay = none
expect selected = 0
key del
key del
key del
key del
key del
key del
expect setup_email =
click prefs:email
type pierre@hosted.test
expect setup_email = pierre@hosted.test
click prefs:password
type secret
click prefs:name
type Pierre Dupont
expect setup_name = Pierre Dupont
expect setup_sections =
click prefs:add
expect setup_sections = imap
expect setup_imap_host = imap.hosted.test
expect setup_imap_reason ~ mx.hosted.test
expect prefs_focus = prefs-imap-host
snap preferences-imap
# The guess is right: "On the server" says what will be created, and
# nothing is added yet.
click prefs:add
expect setup_sections = imap,server
expect setup_look_only = false
expect setup_created = Todo,Waiting,Archive,Newsletter,Paperwork,Quarantine,Deleted,Junk,Banned
expect setup_roles ~ sent=Sent,drafts=Drafts
expect setup_calls !~ add_account
snap preferences-plan
# Confirmed: added, with the SMTP server guessed from it.
click prefs:add
expect setup_added ~ pierre@hosted.test added
expect setup_calls ~ add_account correspondents=true display_name=Pierre Dupont email=pierre@hosted.test imap=imap.hosted.test:993
expect setup_calls ~ smtp=smtp.hosted.test:465
expect setup_calls ~ roles=11
expect setup_calls !~ read_only
expect prefs_accounts = perso,fixture,hosted
# The form is empty again, the name of "From" kept for the next one.
expect setup_email =
expect setup_password_set = false
expect setup_name = Pierre Dupont
expect setup_sections =

# A wrong password: said, at the password.
click prefs:email
type pierre@known.test
click prefs:password
type wrong
click prefs:add
expect setup_error ~ refused the password
expect prefs_focus = prefs-password

# The SMTP server refuses the mailbox password: its own is asked.
click prefs:password
key del
key del
key del
key del
key del
type secret
click prefs:add
expect setup_sections = smtp-password
expect setup_smtp_password_reason ~ smtp.known.test refused your mailbox password
expect setup_smtp_password_reason ~ Application-specific password required
expect prefs_focus = prefs-smtp-password
type nope
key ret
expect setup_smtp_password_reason ~ refused this password too
type smtp-pw
key ret
# A big Inbox: the import screen, every box checked, under "On the
# server"; Archive, Sent, Drafts, Trash and Junk found.
expect setup_sections = smtp-password,server,import
expect setup_created = Todo,Waiting,Newsletter,Paperwork,Quarantine,Banned
expect setup_roles ~ deleted=Trash
snap preferences-import
click prefs:archive-unread right
click prefs:add
expect setup_added ~ old mails are being archived
expect setup_added !~ 17
expect setup_calls ~ archive_read_before=2026-11-17
expect setup_calls !~ archive_unread_before
expect setup_calls ~ smtp=smtp.known.test:465 smtp_password=set
expect prefs_accounts = perso,fixture,hosted,known

# No SMTP server answers: added without sending.
click prefs:email
type pierre@nosmtp.test
click prefs:password
type secret
click prefs:add
expect setup_sections = smtp
expect setup_smtp_reason ~ cannot connect to smtp.nosmtp.test
click prefs:send-later right
click prefs:add
expect setup_sections = smtp,server
click prefs:add
expect setup_added ~ pierre@nosmtp.test added
expect prefs_accounts = perso,fixture,hosted,known,nosmtp

# Only looked at: nothing created, nothing archived, read-only.
click prefs:email
type pierre@look.test
click prefs:password
type secret
click prefs:add
expect setup_sections = server
click prefs:look-only right
expect setup_look_only = true
expect setup_created =
snap preferences-look-only
click prefs:add
expect setup_added ~ changes nothing on the server
expect setup_calls ~ read_only=true
expect prefs_accounts = perso,fixture,hosted,known,nosmtp,look

# Organized later, from its page: the same plan, read with the password
# of the Keychain, then applied.
click prefs:account-look
expect prefs_selection = look
snap preferences-looked-at
click prefs:organize
expect activation_plan = true
expect activation_import = false
expect activation_created = Todo,Waiting,Archive,Newsletter,Paperwork,Quarantine,Deleted,Junk,Banned
expect setup_calls ~ prepare_activation account=look
snap preferences-organize
click prefs:activate
expect activation_done ~ pierre@look.test is organized
expect setup_calls ~ activate_account account=look
expect activation_plan = false

# A provider that asks for an app password: said under the password as
# soon as the address is typed, with the guide of the website, and again
# when its server refuses the password of the website.
click prefs:plus
expect prefs_selection = add
click prefs:email
type pierre@gmail.com
expect setup_app_password = gmail
# (Its anchor, after a hash, is checked by AppPasswordTests.)
expect setup_app_password_guide ~ https://nicemailer.org/docs/app-passwords/
click prefs:password
type wrong
click prefs:add
expect setup_error ~ refused the password
expect setup_error ~ Gmail asks for an app password
expect prefs_focus = prefs-password
snap preferences-app-password

# A new password for an account already set (after a new app password,
# say): saved by the core, the field emptied. `set_password` is answered
# by the scripted core: nothing reaches the Keychain.
click prefs:account-look
expect prefs_selection = look
expect password_account = look
expect password_app =
click prefs:new-password
type new-secret
expect password_set = true
key ret
expect password_saved ~ Password saved
expect password_set = false
expect setup_calls ~ set_password account=look password=set
snap preferences-new-password

# Closed: the keys go back to the main window.
preferences close
key j
expect selected = 1
