# Keyboard navigation and selection in the mail list.
expect folder = Inbox
expect selected = 0
key j
key j
expect selected = 2
key k
expect selected = 1
key down
expect selected = 2
key up
expect selected = 1
# J / K mark and move.
key J
key J
expect marked = 1,2,3
expect selected = 3
key esc
expect marked =
# Shift with the arrows does the same as J / K.
key shift-down
key shift-down
expect marked = 3,4,5
expect selected = 5
key shift-up
expect selected = 4
expect marked = 3,4,5
key esc
expect marked =
# Mouse: click, cmd-click, shift-click.
click thread:5
expect selected = 5
expect marked =
click thread:7 cmd
expect marked = 5,7
click thread:7 cmd
expect marked = 5
click thread:2
expect marked =
click thread:6 shift
expect marked = 2,3,4,5,6
expect selected = 6
snap navigation
# ctrl-d / ctrl-u: half a page of the list (Zed), clamped at the top.
click thread:0
expect list_rows > 10
key ctrl-d
expect selected > 4
key ctrl-d
expect selected > 9
key ctrl-u
key ctrl-u
expect selected = 0
key ctrl-u
expect selected = 0
# Many moves in a row, as a held key: the reader ends on the mail under
# the cursor (one load at a time, then the last selection).
key j
key j
key j
key j
key j
key j
key j
key j
expect selected = 8
expect reader_is_selected = true
key k
key k
key k
expect selected = 5
expect reader_is_selected = true
# A long list, gone down with ctrl-d only: the cursor loads the pages that
# follow on its way (`AppModel.prefetchIfNearEnd`), with no mouse scroll.
# All Mail of the seeded account holds more than three pages of 60.
key ;
key m
expect folder = All Mail
expect thread_count = 60
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
expect thread_count > 120
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
key ctrl-d
expect selected > 180
expect thread_count > 210
expect reader_is_selected = true
snap navigation-deep
