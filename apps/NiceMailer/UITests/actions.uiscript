# Prefix menus and actions on the mails of the Inbox (perso account).
expect folder = Inbox
# The move menu opens, Escape closes it.
key m
expect overlay = menu(NiceMailer.InterfaceController.Prefix.move)
expect mode = m
snap move-menu
key esc
expect overlay = none
# m t: move to Todo.
key m
key t
expect flash ~ Todo
# d: done (archive); Delete: move to Deleted.
key d
# The message names the mail (quoted subject) and the folder.
expect flash ~ ” moved to Archive
key del
expect flash ~ Deleted
# Several mails at once.
key J
key J
expect marked_count = 3
key d
expect flash ~ 3
expect marked_count = 0
# Flag toggles.
key *
expect selected_flagged = true
key *
expect selected_flagged = false
# U marks read whatever the state; u toggles.
key U
expect selected_unread = 0
key U
expect selected_unread = 0
key u
expect selected_unread > 0
key U
expect selected_unread = 0
# ⌘A marks every mail of the list; Escape unmarks.
key cmd-a
expect marked_count > 2
expect flash = 
snap all-marked
# Grouped actions (`ui.md`, "Actions groupées"): one request for every
# marked mail, all the rows changed at once. U makes them all read; then
# u all unread (none is), U all read again; * all flagged, then not.
key U
expect marked_unread = 0
key u
expect marked_unread > 2
key U
expect marked_unread = 0
key *
expect marked_flagged > 2
snap all-flagged
key *
expect marked_flagged = 0
key esc
expect marked_count = 0
# Unknown keys and commands are reported, not executed.
key y
expect flash ~ y
key m
key z
expect flash ~ mz
# `R`, `f` and `c` open a reply, a forward, a new mail
# (compose.uiscript, writing.uiscript).
# Help.
key ?
expect overlay = help
# Grouped keys, in three columns in a wide window.
expect help_columns = Navigate,Read,Select | Act on mails | Write,Find and go,Window
snap help
key j
expect overlay = none
# The moved mails are in their folders.
key ;
key t
expect folder = Todo
expect thread_count > 0
