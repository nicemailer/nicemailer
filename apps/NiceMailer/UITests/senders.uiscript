# People and robots (`specifications/expediteurs.md`): the attribute
# human / robot of the selector, and the origin of a contact, forced with `o`.
key ;
key a
expect folder = Archive
expect thread_count > 10
# The two values split the list.
key f
type human
expect picker_first = human
key ret
expect filters = human
expect thread_count > 0
snap human
# The opposite replaces it.
key f
type robot
expect picker_first = robot
key ret
expect filters = robot
expect thread_count > 0
snap robot
click chip:human
expect filters =
# A hidden word reaches it: "person".
key f
type person
expect picker_first = human
key esc
# Contacts: the origin column; `o` forces it, `-` gives it back.
key ;
key c
expect screen = contacts
key /
type gazette
expect contacts_count > 0
key ret
expect contact_origin = robot
key o
expect choice ~ Who writes from
snap origin-choice
key h
expect choice =
expect contact_origin = human *
expect flash = Marked as written by a person
snap contacts-origin
key o
key -
expect contact_origin = robot
key esc
expect screen = mail
