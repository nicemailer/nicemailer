# "Change Mailbox…" checks the folder before switching to it
# (`docs/app-bundle.md`, "Choosing the mailbox"). The folders are made by
# scripts/ui-test.sh in the scenario's data directory; the switch itself is
# only recorded (`mailbox_switched`), never made.
expect mailbox_switched =
# An early development database: refused, the current mailbox kept.
mailbox mailboxes/early
expect error ~ early development version
expect error ~ account.kind
expect mailbox_switched =
expect choice =
# A database of a newer NiceMailer: refused too.
mailbox mailboxes/newer
expect error ~ newer version of NiceMailer
expect error ~ 99
expect mailbox_switched =
# An empty folder: a new mailbox, used at once.
mailbox mailboxes/empty
expect mailbox_switched = empty
# An earlier data format: a question first, nothing done before the answer.
mailbox mailboxes/old
expect mailbox_question = old 1->16
expect error =
expect mode = ASK
expect choice ~ older data format
snap question
# Other keys wait for the answer.
key j
expect mailbox_question = old 1->16
# Escape keeps the current mailbox.
key esc
expect mailbox_question =
expect flash ~ not upgraded
expect mailbox_switched = empty
# Asked again, and answered with a click on "upgrade it": upgraded by the
# CLI, then used.
mailbox mailboxes/old
expect mailbox_question = old 1->16
click menu:0
expect mailbox_switched = empty,old
expect flash ~ old upgraded
expect mailbox_upgrading =
# Now current: used without a question.
mailbox mailboxes/old
expect mailbox_question =
expect mailbox_switched = empty,old,old
# The core in maintenance (`docs/updates.md`): it answers every client with
# the reason, which the app shows and waits for, instead of "unreachable".
# Here the core of the scenario plays it, as the app's probe would read it.
# An update of NiceMailer being installed:
maintenance update
expect core_status ~ maintenance: updating NiceMailer
expect core_status ~ It opens again as soon as the new version is installed
snap updating
# Then the new core upgrading the mailbox, with its progress: shown as the
# probe answers it, without starting a core.
maintenance migration 9 13 11
expect core_status ~ maintenance: upgrading the mailbox
expect core_status ~ data format 13 (from 9, now at 11)
expect core_status ~ 1 min
snap upgrading
# Served again: the app goes on.
maintenance off
expect core_status = connected
# A migration that failed: not waited for; the reason, kept for "Try Again"
# (which restarts the core) and the core's log.
maintenance migration 9 13 9
maintenance migration_failed 9 13
expect core_status ~ failed: The upgrade of this mailbox failed (disque plein)
expect last_maintenance = migration_failed
maintenance off
expect core_status = connected
expect last_maintenance =
# A mailbox written by a newer NiceMailer, the same way.
maintenance newer_schema 14 13
expect core_status ~ written by a newer version of NiceMailer (data format 14; this one reads 13)
maintenance off
expect core_status = connected
# No updates in a UI scenario: Sparkle never starts there.
expect updates_available = false
