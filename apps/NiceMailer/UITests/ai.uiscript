# The AI assistance in a reply (`ia.md`, section 11; docs/ai.md), its
# prompts answered by the core from fixtures/ai.ai.json (NICEMAILER_FAKE_AI):
# ⌘I opens the menu of the reply (not typed), a prompt not available yet
# says so, proofreading shows its differences, the keys do not reach the
# text meanwhile, Return applies them (quotation untouched) and ⌘Z undoes
# them; a variant from the submenu, refused with Escape; a subject chosen
# by its number; `a` with a mail shown: a summary, then a quick reply that
# starts the reply; `a` on the list alone suggests a folder for the mail
# under the cursor; in
# Quarantine, `a` `s` sorts the folder, the rows show their target, Return
# moves one there.
expect folder = Inbox
key r
expect composing = true
type merci je vien jeudi
key cmd-i
expect choice = AI
expect choice_rows ~ c Proofread
expect choice_rows ~ r Rewrite…
expect choice_rows ~ o Suggest subjects
expect choice_rows ~ w Write from my notes
expect compose_text ~ merci je vien jeudi|
snap ai-menu
key w
expect flash ~ Not available yet
expect ai_state = none
# Proofreading: the text is saved, then proposed as differences.
key cmd-i
key c
expect ai_state = proposal
expect ai_title = Proofread
expect ai_diff ~ [-merci -]{+Merci, +}
expect ai_diff ~ [-vien jeudi-]{+viens jeudi.+}
snap ai-proposal
# A letter is not typed while the panel is open.
key x
expect compose_text ~ merci je vien jeudi|
expect ai_state = proposal
key ret
expect ai_state = none
expect flash ~ Applied
# The cursor at the end of the words the AI rewrote, as after typing them.
expect compose_text ~ Merci, je viens jeudi.|
expect compose_text ~ wrote:
expect compose_text ~ \n> 
snap ai-applied
key cmd-z
expect compose_text ~ merci je vien jeudi
expect flash ~ undone
expect compose_saved = true
# A variant from the submenu, refused: the text stays.
key cmd-i
key r
expect choice = Rewrite
expect choice_rows ~ c Shorter
key c
expect ai_state = proposal
expect ai_title = Rewrite · Shorter
key esc
expect ai_state = none
expect compose_text ~ merci je vien jeudi
# Subjects: one chosen by its number.
key cmd-i
key o
expect ai_state = proposal
expect ai_subjects = Jeudi 14h | Confirmation pour jeudi
snap ai-subjects
key 2
expect ai_state = none
expect compose_subject = Confirmation pour jeudi
# Out of the reply, with the mail shown, `a` opens the AI menu of the mail.
key esc
expect composing = false
key a
expect choice = AI
expect choice_rows ~ r Summarize
expect choice_rows ~ p Quick replies
expect choice_rows ~ s Security check
expect choice_rows ~ t Translate…
snap ai-mail-menu
key r
expect ai_state = proposal
expect ai_title = Summarize
expect ai_result ~ Victor asks whether the March invoice is ready.
expect ai_result ~ - Send the March invoice (you)
snap ai-summary
# The panel takes the keys: `j` does not move the list.
key j
expect selected = 0
key esc
expect ai_state = none
key j
expect selected = 1
key k
# A quick reply starts the reply with it, above the quotation.
key a
key p
expect ai_state = proposal
expect ai_result ~ 2. I will send it tomorrow.
key 2
expect composing = true
expect ai_state = none
expect compose_text ~ I will send it tomorrow.|\n\n
expect compose_text ~ wrote:
key esc
# One column, on the list alone: the menu of the list. Nothing marked, a
# folder is suggested for the conversation under the cursor only.
key v
key 1
key a
expect choice_rows ~ Suggest a folder
key s
expect ai_suggestions = 1
expect selected_suggestion ~ archive: Fake reason
# The Quarantine, in two columns: `a` opens the menu of the list (sorting
# is what the folder is for), `s` sorts the whole folder in the background,
# each row shows the target suggested and the status bar why; Return moves
# the conversation there.
key v
key 2
key ;
key q
expect folder = Quarantine
key a
expect choice_rows ~ s Sort the Quarantine
key s
expect ai_suggestions > 0
expect ai_sort = 
expect selected_suggestion ~ newsletter: Fake reason
expect flash ~ suggestions
snap ai-quarantine
expect thread_count > 2
key ret
expect flash ~ Newsletter
expect selected_suggestion ~ newsletter: Fake reason
