# The AI assistance in a reply (`ia.md`, section 11; docs/ai.md), its
# prompts answered by the core from fixtures/ai.ai.json (NICEMAILER_FAKE_AI):
# ⌘I on a word selected offers its other wordings, the first put in its
# place by Return; without a selection, ⌘I opens the palette of the whole
# text (not typed): typing filters, the
# first row, highlighted, runs with Return; a prompt not available yet
# says so, proofreading shows its differences, the keys do not reach the
# text meanwhile, Return applies them (quotation untouched) and ⌘Z undoes
# them; a variant from the submenu, refused with Escape; a subject chosen
# by its number; `a` with a mail shown: a summary, then a quick reply that
# starts the reply; `a` on the list alone offers the prompts of the row
# under the cursor, and filing with several marked; in
# Quarantine, `a` `s` sorts the folder, the rows show their target, Return
# moves one there.
expect folder = Inbox
key r
expect composing = true
type merci je vien jeudi
# A word selected: the palette of a passage, its other wordings first;
# ⌘I ↩ ↩ puts the first one in its place, ⌘Z gives the word back.
key shift-alt-left
key cmd-i
expect picker_first = Other wordings
expect picker_rows ~ Proofread
expect picker_rows !~ Suggest subjects
snap ai-passage-menu
key ret
expect ai_state = proposal
expect ai_result ~ 1. vendredi
snap ai-passage
key ret
expect ai_state = none
expect compose_text ~ merci je vien vendredi|
key cmd-z
expect compose_text ~ merci je vien jeudi|
# Nothing selected: the palette of the whole text.
key cmd-i
expect ai_placement = palette
expect picker_first = Proofread
expect picker_rows ~ Proofread | Rewrite · More formal
expect picker_rows ~ Translate · Into English
expect picker_rows ~ Suggest subjects
expect picker_rows ~ Write from my notes
expect compose_text ~ merci je vien jeudi|
snap ai-menu
type w
key ret
expect flash ~ Not available yet
expect ai_state = none
# Proofreading, the first row, highlighted: ⌘I then Return. The text is
# saved, then proposed as differences.
key cmd-i
expect picker_index = 0
key ret
expect ai_state = proposal
expect ai_placement = panel
expect ai_title = Proofread
expect ai_diff ~ [-merci -]{+Merci, +}
expect ai_diff ~ [-vien jeudi-]{+viens jeudi.+}
snap ai-proposal
# A letter is not typed while the panel is open.
key x
expect compose_text ~ merci je vien jeudi|
expect ai_state = proposal
key ret
expect ai_state = none
expect flash ~ Applied
# The cursor at the end of the words the AI rewrote, as after typing them.
expect compose_text ~ Merci, je viens jeudi.|
expect compose_text ~ wrote:
expect compose_text ~ \n> 
snap ai-applied
key cmd-z
expect compose_text ~ merci je vien jeudi
expect flash ~ undone
expect compose_saved = true
# A variant, a row of the palette found by its letters (`rc`), refused:
# the text stays.
key cmd-i
type rc
expect picker_first = Rewrite · Shorter
key ret
expect ai_state = proposal
expect ai_title = Rewrite · Shorter
key esc
expect ai_state = none
expect compose_text ~ merci je vien jeudi
# Subjects (`o`): one chosen by its number.
key cmd-i
type o
key ret
expect ai_state = proposal
expect ai_subjects = Jeudi 14h | Confirmation pour jeudi
snap ai-subjects
key 2
expect ai_state = none
expect compose_subject = Confirmation pour jeudi
# Out of the reply, with the mail shown, `a` opens the AI menu of the mail.
key esc
expect composing = false
key a
expect ai_placement = palette
expect picker_first = Summarize
expect picker_rows ~ Summarize | Quick replies
expect picker_rows ~ Security check
expect picker_rows ~ Translate · Into English
snap ai-mail-menu
key ret
expect ai_state = proposal
expect ai_placement = panel
expect ai_title = Summarize
expect ai_result ~ Victor asks whether the March invoice is ready.
expect ai_result ~ - Send the March invoice (you)
snap ai-summary
# The panel takes the keys: `j` does not move the list.
key j
expect selected = 0
key esc
expect ai_state = none
key j
expect selected = 1
key k
# A quick reply starts the reply with it, above the quotation.
key a
type p
key ret
expect ai_state = proposal
expect ai_result ~ 2. I will send it tomorrow.
key 2
expect composing = true
expect ai_state = none
expect compose_text ~ I will send it tomorrow.|\n\n
expect compose_text ~ wrote:
key esc
# One column, on the list alone, nothing marked: the row under the cursor
# is the mail, its prompts are offered, not filing it.
key v
key 1
key a
expect ai_placement = palette
expect picker_first = Summarize
key esc
# Several marked: filing them, the mail's prompts gone.
key J
key J
expect marked_count = 3
key a
expect picker_first = Suggest a folder
expect picker_rows !~ Summarize
key ret
expect ai_suggestions = 3
expect selected_suggestion ~ archive: Fake reason
# The Quarantine, in two columns: `a` opens the palette of the mail shown,
# the sorting of the whole folder first (what the folder is for), the
# security check among the mail's prompts; Return sorts in the background,
# each row shows the target suggested and the status bar why; Return moves
# the conversation there.
key v
key 2
key ;
key q
expect folder = Quarantine
key a
expect picker_first = Sort the Quarantine
expect picker_rows ~ Security check
key ret
expect ai_suggestions > 0
expect ai_sort = 
expect selected_suggestion ~ newsletter: Fake reason
expect flash ~ suggestions
snap ai-quarantine
expect thread_count > 2
key ret
expect flash ~ Newsletter
expect selected_suggestion ~ newsletter: Fake reason
