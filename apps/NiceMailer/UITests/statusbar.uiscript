# Account and folder in the status bar: icons, key reminders, pickers by
# key and by click, and the unified account "all".
expect account = all
expect folder = Inbox
# The launch is over once the first list is shown, and it was timed
# (`StartupTimings`, written to the system log); the status bar no longer
# says "Loading the mail…".
expect startup_phase = ready
expect startup_ms > 0
# The normal mode shows the app's icon at the left; the other modes are
# written (a prefix waiting for its key: its letter).
expect mode = NOR
expect mode_icon = true
snap mode-icon
key v
expect mode = v
expect mode_icon = false
key esc
expect mode_icon = true
# The account picker: @, or a click on the account. "all" comes first.
key @
expect overlay = picker(NiceMailer.InterfaceController.PickerKind.accounts)
expect picker_count = 3
snap account-picker
# The picker turns around: up from the first row (where it opens) selects
# the last one, down from the last one comes back to the first.
expect picker_index = 0
key up
expect picker_index = 2
key down
expect picker_index = 0
key down
expect picker_index = 1
key esc
click status:account
expect overlay = picker(NiceMailer.InterfaceController.PickerKind.accounts)
type fixture
key ret
expect account = fixture
# Same role (Inbox) in the other account.
expect folder = Inbox
# The status bar is at the top by default; at the bottom first (v s twice:
# top, hidden, bottom).
expect status_position = top
key v
key s
key v
key s
expect status_position = bottom
# The ; menu: a click on the folder; folders of this account only. It drops
# down on the left, from the folder block: just above the bar at the
# bottom (window height 900, origin at the bottom).
click status:folder
expect overlay = menu(NiceMailer.InterfaceController.Prefix.goto)
expect menu_x < 400
expect menu_y < 500
snap folder-menu-bottom
key a
expect folder = Archive
# Back to "all", still in Archive: the archives of every account.
key @
click picker:0
expect account = all
expect folder = Archive
expect thread_count > 4
# Then the first account, still in Archive.
key @
click picker:1
expect account = perso
expect folder = Archive
# The folder column shows one block, titled with the current view.
key v
key 3
snap folder-column
key @
click picker:0
expect account = all
snap status-bar
# With the status bar at the top, the menu drops down under it, top left.
key v
key s
expect status_position = top
key ;
expect menu_x < 400
expect menu_y > 500
snap folder-menu-top
key esc
# The m, s and v menus have their block (icon and key) and drop down from
# it, like the folder menu.
click status:v
expect overlay = menu(NiceMailer.InterfaceController.Prefix.view)
expect menu_x > 100
expect menu_y > 500
snap view-menu-top
key esc
click status:m
expect overlay = menu(NiceMailer.InterfaceController.Prefix.move)
key esc
click status:s
expect overlay = menu(NiceMailer.InterfaceController.Prefix.save)
key esc
# The ? block at the right end opens the list of keys; a second click
# closes it, as does any key.
click status:help
expect overlay = help
snap help-from-status-bar
click status:help
expect overlay = none
click status:help
key j
expect overlay = none
