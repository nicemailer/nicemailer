# Display menu (v), text / HTML, scrolling and saving.
key v
key 1
expect columns = 1
key v
key 3
expect columns = 3
snap three-columns
# The folder column of the unified view: one block, titled "all".
expect account = all
click folder:Todo
expect folder = Todo
click folder:Inbox
expect folder = Inbox
key v
key 2
expect columns = 2
# Status bar position.
key v
key s
expect status_position = top
key v
key s
expect status_position = hidden
key v
key s
expect status_position = bottom
# Sort.
key v
key m
expect sort = modified
key v
key c
expect sort = received
# Text / HTML on the HTML newsletter of the archive account.
key @
type fixture
key ret
key ;
key a
expect selected_subject = La lettre de novembre
expect body_format = text
# The HTML-only newsletter converted to text by the core keeps its blocks
# apart (title, then paragraph).
expect reader_text ~ Les nouveautés du mois
expect reader_text !~ NovembreLes
# Its three attachments are tiles at its foot (the logo shown by its HTML
# is not one). A click saves the file to the export directory; ⌘-click
# saves it and opens the saved copy (recorded only, in UI script mode).
expect reader_attachments = 3
expect reader_text ~ devis.pdf
expect reader_text ~ budget.xlsx
expect reader_text !~ logo.png
snap attachments
click attachment:0
expect export_files = 1
expect flash ~ devis.pdf
click attachment:1 cmd
expect export_files = 2
expect opened_file = photo.png
# The l picker lists them after the links.
key l
expect picker_count = 3
type budget
key ret
expect export_files = 3
expect flash ~ budget.xlsx
# ⌘-Return saves the file, then opens the saved copy (devis.pdf is taken).
key l
type devis
key cmd-ret
expect export_files = 4
expect opened_file = devis (2).pdf
expect flash ~ opened
# Unsubscribe: the newsletter's List-Unsubscribe header allows one click;
# the core does it (no request in UI tests) and the button gives way to
# "unsubscribed".
expect unsubscribe = header:one_click
snap unsubscribe
click reader:unsubscribe
expect flash ~ Unsubscribed from Lettre
expect unsubscribe = done
key v
key h
expect body_format = html
# The page shows the mail, in the bundled font.
expect html_text ~ Les nouveautés du mois
expect html_text ~ devis.pdf
expect html_font_loaded = 1
expect html_font_family ~ NM Mono
snap html
key v
key h
expect body_format = text
# Scrolling a long mail.
key j
key j
expect selected_subject = Un long mail
# Its unsubscribe link is in its text: ⌘U opens it in the browser.
expect unsubscribe = body:browser
snap unsubscribe-body
key cmd-u
expect opened_file = https://example.org/desabonnement
expect reader_offset = 0
key space
expect reader_offset > 0
key shift-space
expect reader_offset = 0
key ctrl-f
expect reader_offset > 0
key ctrl-b
expect reader_offset = 0
# The same keys scroll the mail shown as HTML (a web view, scrolled by
# the page itself).
key v
key h
expect body_format = html
expect html_text ~ Ligne 1 du long mail
expect html_offset = 0
key space
expect html_offset > 0
key shift-space
expect html_offset = 0
key ctrl-f
expect html_offset > 0
key ctrl-b
expect html_offset = 0
key v
key h
expect body_format = text
# ctrl-d moves the list, not the mail.
key ctrl-d
expect reader_offset = 0
expect selected_subject != Un long mail
# Saving the mail (to the test export directory).
key s
key e
expect export_files = 5
key s
key t
expect export_files = 6
key s
key m
expect export_files = 7
# sa / sg: the attachments of the mail under the cursor (the newsletter:
# three files, one of them a graphic), then of every marked mail.
click thread:0
expect selected_subject = La lettre de novembre
key s
key a
expect export_files = 10
expect flash ~ 3 attachments saved
key s
key g
expect export_files = 12
key J
expect marked_count = 2
key s
key a
expect export_files = 15
# se also saves the latest mail of every marked conversation.
key s
key e
expect export_files = 17
expect flash ~ 2 mails saved
key esc
expect marked_count = 0
