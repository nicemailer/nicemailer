# Show menu (v), text / HTML, scrolling and saving.
key v
key 1
expect columns = 1
# One column shows the list only: Return reads the mail in the whole
# window, j moves to the next mail, Escape goes back to the list.
expect reading = false
expect selected_unread > 0
# The list alone shows no content: staying on a row marks nothing, even
# on an unread mail chosen with j (the third row), nor leaving it.
key j
key j
expect selected = 2
expect selected_unread > 0
wait 1500
expect selected_unread > 0
key k
key k
expect selected = 0
expect selected_unread > 0
key ret
expect reading = true
# Opening the mail marks it read at once.
expect selected_unread = 0
expect reader_text ~ Bonjour Alex
snap one-column-reading
key j
expect reading = true
key esc
expect reading = false
snap one-column-list
# A double-click on a row reads it too; a single click only selects it.
click thread:3
expect reading = false
expect selected = 3
dblclick thread:4
expect reading = true
expect selected = 4
key esc
expect reading = false
# Space opens the mail too, then scrolls it; Escape goes back.
key space
expect reading = true
expect selected = 4
key space
expect reading = true
key esc
expect reading = false
# ⌃⌘F asks for full screen (counted only: the test window stays off screen).
expect fullscreen_toggles = 0
key ctrl-cmd-f
expect fullscreen_toggles = 1
key v
key 3
expect columns = 3
# geek: the key first, 8 pt from the column's edge, then the name, as
# always (8 + the key + 6).
expect folder_inbox_layout = 22,,
snap three-columns
# The folder column of the unified view: one block, titled "all".
expect account = all
click folder:Todo
expect folder = Todo
click folder:Inbox
expect folder = Inbox
key v
key 2
expect columns = 2
# Status bar position: at the top by default, then hidden, at the bottom,
# and back at the top.
expect status_position = top
key v
key s
expect status_position = hidden
key v
key s
expect status_position = bottom
key v
key s
expect status_position = top
# Sort.
key v
key m
expect sort = modified
key v
key c
expect sort = received
# Text / HTML on the HTML newsletter of the archive account.
key @
type fixture
key ret
key ;
key a
expect selected_subject = La lettre de novembre
expect body_format = text
# The list: a paperclip before the subject of a mail with attachments (no
# number, apart from the message count), the flag in orange at the end.
key I
expect selected_flagged = true
snap list-icons
key I
expect selected_flagged = false
# The HTML-only newsletter converted to text by the core keeps its blocks
# apart (title, then paragraph).
expect reader_text ~ Les nouveautés du mois
expect reader_text !~ NovembreLes
# Its three attachments are tiles at its foot (the logo shown by its HTML
# is not one). A click saves the file to the export directory; ⌘-click
# saves it and opens the saved copy (recorded only, in UI script mode).
expect attachment_layout = tiles
expect reader_attachments = 3
expect reader_text ~ devis.pdf
expect reader_text ~ budget.xlsx
expect reader_text !~ logo.png
snap attachments
click attachment:0
expect export_files = 1
expect flash ~ devis.pdf
click attachment:1 cmd
expect export_files = 2
expect opened_file = photo.png
# The l picker lists them after the link to the mail, the links and the
# phone number of the newsletter.
key l
expect picker_count = 8
type budget
key ret
expect export_files = 3
expect flash ~ budget.xlsx
# ⌘-Return saves the file, then opens the saved copy (devis.pdf is taken).
key l
type devis
key cmd-ret
expect export_files = 4
expect opened_file = devis (2).pdf
expect flash ~ opened
# Unsubscribe: the newsletter's List-Unsubscribe header allows one click;
# the core does it (no request in UI tests) and the button gives way to
# "unsubscribed".
expect unsubscribe = header:one_click
snap unsubscribe
click reader:unsubscribe
expect flash ~ Unsubscribed from Lettre
expect unsubscribe = done
# The day it was done, not the time ("unsubscribed 09:57" read as a time).
expect unsubscribe_text ~ unsubscribed
expect unsubscribe_text !~ :
key v
key h
expect body_format = html
# The page shows the mail, in the bundled font.
expect html_text ~ Les nouveautés du mois
expect html_text ~ devis.pdf
expect html_font_loaded = 1
expect html_font_family ~ NM Mono
snap html
key v
key h
expect body_format = text
# Scrolling a long mail.
key j
key j
expect selected_subject = Un long mail
# Its unsubscribe link is in its text: ⌘U opens it in the browser.
expect unsubscribe = body:browser
snap unsubscribe-body
key cmd-u
expect opened_file = https://example.org/desabonnement
expect body_format = text
expect reader_offset = 0
key space
expect reader_offset > 0
key shift-space
expect reader_offset = 0
key ctrl-f
expect reader_offset > 0
key ctrl-b
expect reader_offset = 0
# The same keys scroll the mail shown as HTML (a web view, scrolled by
# the page itself).
key v
key h
expect body_format = html
expect html_text ~ Ligne 1 du long mail
expect html_offset = 0
key space
expect html_offset > 0
key shift-space
expect html_offset = 0
key ctrl-f
expect html_offset > 0
key ctrl-b
expect html_offset = 0
key v
key h
expect body_format = text
# sc, the first row of the menu s: the mail (its headers, then its text)
# on the pasteboard, nothing saved. Its 300 lines are 300 sentences, one
# per line: they stay apart. 4 header lines, an empty line, the 300
# lines, an empty line, the unsubscribe line: 307.
key s
key c
expect pasteboard ~ Subject: Un long mail
expect pasteboard ~ Ligne 300 du long mail
expect pasteboard ~ Se désabonner
expect pasteboard_lines = 307
expect flash ~ copied to the clipboard
expect export_files = 4
# ctrl-d moves the list, not the mail.
key ctrl-d
expect reader_offset = 0
expect selected_subject != Un long mail
# Saving the mail (to the test export directory).
key s
key e
expect export_files = 5
key s
key t
expect export_files = 6
key s
key m
expect export_files = 7
# The capitals save, then open the file in front (recorded only in UI
# script mode). The menu says so on the row, muted.
key s
snap save-menu
key T
expect export_files = 8
expect opened_file ~ .txt
expect flash ~ Saved and opened
key s
key M
expect export_files = 9
expect opened_file ~ .md
# ⌘-Return on a highlighted row (the third, "as text file", after "to
# clipboard" and "as .eml file"): the same.
key s
key down
key down
key down
key cmd-ret
expect export_files = 10
expect opened_file ~ .txt
# sa / sg: the attachments of the mail under the cursor (the newsletter:
# three files, one of them a graphic), then of every marked mail.
click thread:0
expect selected_subject = La lettre de novembre
key s
key a
expect export_files = 13
expect flash ~ 3 attachments saved
key s
key g
expect export_files = 15
key J
expect marked_count = 2
key s
key a
expect export_files = 18
# se also saves the latest mail of every marked conversation.
key s
key e
expect export_files = 20
expect flash ~ 2 mails saved
# sp: a PDF of the latest mail of every marked conversation, read by the
# core from the raw message; sP saves them again, never over the first
# ones, and opens them.
key s
key p
expect export_files = 22
expect flash ~ 2 mails saved
key s
key P
expect export_files = 24
expect opened_file ~ (2).pdf
expect flash ~ opened
# si, the last row of the menu: the PDF with the technical information
# (the evidence); sI opens it too.
key s
expect menu_rows ~ i as PDF with technical information
key i
expect export_files = 26
expect flash ~ 2 mails saved
key s
key I
expect export_files = 28
expect opened_file ~ (4).pdf
expect flash ~ opened
key esc
expect marked_count = 0
