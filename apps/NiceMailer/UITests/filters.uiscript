# Attribute selector (F, or a click on the magnifier in the status bar).
expect filters =
expect thread_count > 10
key F
expect overlay = picker(NiceMailer.GeekController.PickerKind.attributes)
snap attribute-selector
type unread
key ret
expect filters = unread
expect thread_count > 0
# Reading in a list of unread mails. The mail selected when the list opens
# is not marked read by itself: the list no longer empties itself.
expect selected = 0
expect selected_unread > 0
wait 1500
expect selected = 0
expect selected_unread > 0
# A mail chosen by hand is marked read after a second (the core's events
# refresh the list) but stays under the cursor until the user leaves it.
key j
wait 1500
expect selected_unread = 0
expect sticky != 
snap kept-read-mail
key j
expect sticky =
expect selected_unread > 0
# Typing ranks the rows: the one starting with the typed text comes first,
# so "read" chooses "read", not "unread" listed before it (it replaces
# "unread"); initials reach a negative value; a hidden word finds To….
key F
type read
expect picker_first = read
key ret
expect filters = read
key F
type nf
expect picker_first = not flagged
key ret
expect filters = read, not flagged
key F
type cc
expect picker_first = To…
key esc
# Back to unread only.
key F
type unread
key ret
click chip:flagged
expect filters = unread
# Several attributes are combined; a value attribute expands the panel.
click status:attributes
type From
key ret
expect overlay = picker(NiceMailer.GeekController.PickerKind.attributeValue(NiceMailer.AttributeField.from))
type moreau
snap from-panel
key ret
expect filters = unread, from: moreau
# The owner's mails are in Sent: none left in the Inbox, and the reading
# pane shows nothing either.
expect thread_count = 0
expect reader_subject =
# Date: the input line says a date or a duration can be typed, six
# digits included.
key F
type Date
key ret
expect picker_hint ~ 011026
expect picker_hint ~ 10d
snap date-panel
# Six digits that make two dates: four rows, each with its reading.
type 010120
expect picker_count > 3
expect picker_first = after 2020-01-01
expect picker_first_detail = dd mm yy
snap date-six-digits
key esc
# Then a preset.
key F
type Date
key ret
type last 30
expect picker_hint =
key ret
expect filters ~ last 30 days
# A duration: its rows say the date it gives; "older than" is the upper
# bound, kept with the lower one (an interval, two chips).
key F
type Date
key ret
type 1w
expect picker_first = newer than 1 week
snap date-duration
key down
key ret
expect filters ~ last 30 days, older than 1 week
# Text: words of the subject and body.
key F
type Text
key ret
type facture
key ret
expect filters ~ text: facture
snap chips
# A click on a chip removes it.
click chip:text
expect filters !~ text:
# The attributes stay when changing folder.
key ;
key a
expect folder = Archive
expect filters ~ unread
# "Everything" (;e, at the foot of the folders) searches every folder
# (without "from: moreau": the owner's own mails are all read).
click chip:from:0
key ;
key e
expect folder = Everything
expect account = all
expect thread_count > 0
# Each mail shows its folder and, in "all", its account: in the list and
# at the right end of the subject line in the reader.
expect reader_folder ~ ·
snap everything
# Escape clears them (after the marks).
key esc
expect filters =
# Everything of one account: the folder only, without the account.
key @
type perso
key ret
expect account = perso
expect folder = Everything
expect reader_folder != 
expect reader_folder !~ ·
# A plain folder: no folder label (the status bar names it).
key ;
key i
expect folder = Inbox
expect reader_folder = 
# Text… against `/`, and exclusions, in the fixture account (4 threads:
# Rapport mensuel, La lettre de novembre, Un long mail, Chantier).
key @
type fixture
key ret
key ;
key e
expect folder = Everything
expect thread_count = 4
# `/` also searches the addresses: Bob sent one thread, and is in copy of
# another.
key /
type bob
key ret
expect filters = anywhere: bob
expect thread_count = 2
key esc
expect folder = Everything
expect filters =
# Text… never looks at the addresses.
key F
type Text
key ret
type bob
key ret
expect filters = text: bob
expect thread_count = 0
click chip:text
# A value typed with "-" is excluded: a domain (with "@"), not only a
# part of the address.
key F
type From
key ret
type -@example.org
expect picker_first = not @example.org
snap exclusion-panel
key ret
expect filters = not from: @example.org
expect thread_count = 1
expect selected_subject ~ lettre
# The exclusion is also the row under the value (one arrow down).
key F
type To
key ret
type @example.org
key down
key ret
expect filters = not from: @example.org, not to: @example.org
expect thread_count = 1
snap exclusions
key esc
expect filters =
expect thread_count = 4
