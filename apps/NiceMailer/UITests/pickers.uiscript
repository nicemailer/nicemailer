# Pickers (folders, links, tags, groups) and search (/).
# The ; menu lists the folders of the current view only (here the unified
# view "all": one entry per role); h is not a command any more.
key h
expect overlay = none
key ;
snap goto-menu
key a
expect account = all
expect folder = Archive
# The arrows highlight a row of the menu (down: Inbox first, then Todo;
# up from nothing: the last row), Return goes there.
key ;
expect menu_index =
key down
expect menu_index = 0
key down
expect menu_index = 1
snap goto-menu-highlight
key ret
expect overlay = none
expect folder = Todo
key ;
key up
expect overlay ~ menu
expect menu_index > 5
key esc
expect overlay = none
key ;
key a
expect folder = Archive
# The account is chosen with @.
key @
type fixture
key ret
expect account = fixture
expect folder = Archive
# Links: after the link to the mail itself (deeplinks.uiscript), the
# newsletter (HTML only) has a link shown by its text (its full
# address in the right half of the row), a phone
# number written in its text, three attached files, then a link around its
# logo (no text: last); the report one link, in its HTML and its text,
# listed once with the text of the HTML.
expect selected_subject = La lettre de novembre
key l
expect picker_count = 8
expect picker_first = Link to this mail
expect picker_rows = Link to this mail | Lire en ligne | ressent "les angoisses" du pays (and 1 other) | 01 23 45 67 89 | devis.pdf | photo.png | budget.xlsx | social.example.net
expect picker_first_detail ~ nicemailer://m/
# As wide as the window allows (1400 points here), 1100 at most.
expect picker_width = 1100
snap links-newsletter
# In a narrower window, the window less a margin on each side.
key esc
resize 900x700
key l
expect picker_width = 820
key esc
resize 1400x900
key l
# Three touching tracking links to one video are one row, named by their
# joined text; the video is linked once more further on ("1 other"). Its
# other text, and the video's address, find it.
type la vidéo
expect picker_first = ressent "les angoisses" du pays (and 1 other)
key esc
key l
type video.example.net
expect picker_count = 1
key esc
key l
# A part of the address, not shown, finds the link too.
type novembre?u
expect picker_count = 1
expect picker_first = Lire en ligne
key esc
# Return on the number hands it to the phone app (recorded only).
key l
type 01 23
expect picker_first = 01 23 45 67 89
key ret
expect opened_file = tel:0123456789
expect overlay = none
key j
expect selected_subject = Rapport mensuel
key l
# Alice, its sender, has a card in the scenario's address book
# (addressbook.uiscript): her numbers and card come before the mail's link.
expect picker_count = 5
expect picker_rows = Link to this mail | Alice Martin — mobile | Alice Martin — work | Card of Alice Martin | ici
key esc
expect overlay = none
# Tag: create by typing, then remove by clicking it in the picker.
key t
type VIP
key ret
expect selected_tags = VIP
key t
expect picker_count = 1
click picker:0
expect selected_tags =
# Group: add the sender, then see the group.
key g
type Amis
key ret
expect flash ~ Amis
key ;
key g
expect groups_count = 1
key esc
# The ; menu with the mouse: a click on the folder of the status bar, then
# on a row (the first one is the Inbox).
click status:folder
expect overlay = menu(NiceMailer.GeekController.Prefix.goto)
click menu:0
expect account = fixture
expect folder = Inbox
# Search (/): words anywhere (addresses included), applied to "All Mail" of the
# view (every folder but Deleted, Junk and Banned); the list is the ordinary
# one, with the chip and the folder column. Escape comes back to the folder /
# was pressed from.
key /
expect overlay = picker(NiceMailer.GeekController.PickerKind.search)
type rapport
expect picker_count = 1
snap search-panel
key ret
expect overlay = none
expect folder = All Mail
expect account = fixture
expect filters ~ rapport
expect search_origin ~ folder:
expect thread_count > 0
expect reader_folder != 
snap search
key esc
expect folder = Inbox
expect account = fixture
expect filters =
expect search_origin =
# The folder menu: four blocks, each ended by its virtual folder, drawn
# apart (`ui.md`, "Dossiers virtuels").
key ;
expect menu_rows ~ i Inbox | t Todo | w Waiting | o Work* || a Archive
expect menu_rows ~ q Quarantine || s Sent
expect menu_rows ~ r Drafts | m All Mail* || d Deleted
expect menu_rows ~ b Banned | e Everything* || c Contacts
snap folder-menu
key esc
# The three virtual folders: `;o` Work (Inbox, Todo, Waiting), `;m` All
# Mail, `;e` Everything; a search from Everything stays in Everything.
# Work of this account (an mbox import: all filed) is empty; that of "all"
# holds the Inbox, Todo and Waiting of the generated account.
key ;
key o
expect folder = Work
expect thread_count = 0
key @
type all
key ret
expect account = all
expect folder = Work
expect thread_count > 0
snap work
key @
type fixture
key ret
expect folder = Work
key ;
key m
expect folder = All Mail
key ;
key e
expect folder = Everything
key /
type rapport
key ret
expect folder = Everything
expect filters ~ rapport
key esc
expect folder = Everything
key ;
key i
expect folder = Inbox
