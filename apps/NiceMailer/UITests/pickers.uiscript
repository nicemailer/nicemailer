# Pickers (folders, links, tags, groups) and search.
# The folder picker lists the folders of the current view only (here the
# unified view "all": one entry per role).
key h
expect overlay = picker(NiceMailer.GeekController.PickerKind.folders)
expect picker_count = 12
type arc
expect picker_count = 1
snap folder-picker
key ret
expect account = all
expect folder = Archive
# The account is chosen with @.
key @
type fixture
key ret
expect account = fixture
expect folder = Archive
# Links: the newsletter has none, the report one.
expect selected_subject = La lettre de novembre
key l
expect picker_count = 0
key esc
key j
expect selected_subject = Rapport mensuel
key l
expect picker_count = 1
key esc
expect overlay = none
# Tag: create by typing, then remove by clicking it in the picker.
key t
type VIP
key ret
expect selected_tags = VIP
key t
expect picker_count = 1
click picker:0
expect selected_tags =
# Group: add the sender, then see the group.
key g
type Amis
key ret
expect flash ~ Amis
key ;
key g
expect groups_count = 1
key esc
# Folder picker with the mouse.
key h
click picker:0
expect account = fixture
expect folder = Inbox
# Search: type, keep the results, click, double-click opens.
key /
type rapport
expect search_count > 0
key ret
expect overlay = none
click search:1
expect search_index = 1
key k
expect search_index = 0
snap search
dblclick search:0
expect search_text =
expect reader_subject != 
