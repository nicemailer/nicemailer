# Pickers (folders, links, tags, groups) and search.
# The ; menu lists the folders of the current view only (here the unified
# view "all": one entry per role); h is not a command any more.
key h
expect overlay = none
key ;
snap goto-menu
key a
expect account = all
expect folder = Archive
# The account is chosen with @.
key @
type fixture
key ret
expect account = fixture
expect folder = Archive
# Links: the newsletter has none, the report one.
expect selected_subject = La lettre de novembre
key l
expect picker_count = 0
key esc
key j
expect selected_subject = Rapport mensuel
key l
expect picker_count = 1
key esc
expect overlay = none
# Tag: create by typing, then remove by clicking it in the picker.
key t
type VIP
key ret
expect selected_tags = VIP
key t
expect picker_count = 1
click picker:0
expect selected_tags =
# Group: add the sender, then see the group.
key g
type Amis
key ret
expect flash ~ Amis
key ;
key g
expect groups_count = 1
key esc
# The ; menu with the mouse: a click on the folder of the status bar, then
# on a row (the first one is the Inbox).
click status:folder
expect overlay = menu(NiceMailer.GeekController.Prefix.goto)
click menu:0
expect account = fixture
expect folder = Inbox
# Search: type, keep the results, click, double-click opens.
key /
type rapport
expect search_count > 1
# The results turn around: up from the first selects the last, down from
# the last comes back to the first, while typing and after Return, which
# keeps the row chosen with the arrows.
expect search_index = 0
key up
expect search_index > 0
expect search_text = rapport
key down
expect search_index = 0
key up
key ret
expect overlay = none
expect search_index > 0
click search:1
expect search_index = 1
key k
expect search_index = 0
key up
expect search_index > 1
key j
expect search_index = 0
key up
# ctrl-u goes back up by half pages, without wrapping.
key ctrl-u
key ctrl-u
key ctrl-u
expect search_index = 0
snap search
dblclick search:0
expect search_text =
expect reader_subject != 
