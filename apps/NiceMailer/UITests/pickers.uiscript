# Pickers (folders, links, tags, groups) and search (/).
# The ; menu lists the folders of the current view only (here the unified
# view "all": one entry per role); h is not a command any more.
key h
expect overlay = none
key ;
snap goto-menu
key a
expect account = all
expect folder = Archive
# The arrows highlight a row of the menu (down: Inbox first, then Todo;
# up from nothing: the last row), Return goes there.
key ;
expect menu_index =
key down
expect menu_index = 0
key down
expect menu_index = 1
snap goto-menu-highlight
key ret
expect overlay = none
expect folder = Todo
key ;
key up
expect overlay ~ menu
expect menu_index > 5
key esc
expect overlay = none
key ;
key a
expect folder = Archive
# The account is chosen with @.
key @
type fixture
key ret
expect account = fixture
expect folder = Archive
# Links: the newsletter has none, the report one.
expect selected_subject = La lettre de novembre
key l
expect picker_count = 0
key esc
key j
expect selected_subject = Rapport mensuel
key l
expect picker_count = 1
key esc
expect overlay = none
# Tag: create by typing, then remove by clicking it in the picker.
key t
type VIP
key ret
expect selected_tags = VIP
key t
expect picker_count = 1
click picker:0
expect selected_tags =
# Group: add the sender, then see the group.
key g
type Amis
key ret
expect flash ~ Amis
key ;
key g
expect groups_count = 1
key esc
# The ; menu with the mouse: a click on the folder of the status bar, then
# on a row (the first one is the Inbox).
click status:folder
expect overlay = menu(NiceMailer.GeekController.Prefix.goto)
click menu:0
expect account = fixture
expect folder = Inbox
# Search (/): the panel of F → Contains…, applied to "Everything" of the
# view; the list is the ordinary one, with the chip and the folder column.
# Escape comes back to the folder / was pressed from.
key /
expect overlay = picker(NiceMailer.GeekController.PickerKind.search)
type rapport
expect picker_count = 1
snap search-panel
key ret
expect overlay = none
expect folder = Everything
expect account = fixture
expect filters ~ rapport
expect search_origin ~ folder:
expect thread_count > 0
expect reader_folder != 
snap search
key esc
expect folder = Inbox
expect account = fixture
expect filters =
expect search_origin =
