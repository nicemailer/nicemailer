# Replying to a mail (`reponse.md`): `r` on the mail of the Inbox (account
# perso), the text typed above the quotation, Escape keeps the draft and `r`
# resumes it, ⌘⌫ abandons it and `z` gives it back, ⌘↩ queues it and `z`
# cancels it during the undo delay, then ⌘↩ sends it for good: the
# conversation is filed in Archive, and `z` puts it back. The core of the
# UI tests sends nothing anywhere (NICEMAILER_FAKE_NETWORK).
expect folder = Inbox
expect composing = false
key r
expect composing = true
expect mode = EDT
expect compose_subject ~ Re:
expect compose_to ~ @
expect compose_from = alex@moreau-conseil.fr
expect compose_after = archive
# The cursor at the start, above the line introducing the quotation.
expect compose_text ~ |\n\n
expect compose_text ~ wrote:
expect compose_text ~ \n> 
snap reply-open
# Letters are text, not commands: `d` does not archive, `j` does not move.
type Merci d'avance, je regarde
expect compose_text ~ Merci d'avance, je regarde|
expect selected = 0
key ret
type Achille
expect compose_text ~ je regarde\nAchille|
key del
expect compose_text ~ \nAchill|
key left
key left
expect compose_text ~ \nAchi|ll
key up
expect compose_text ~ Merc|i
key cmd-right
expect compose_text ~ je regarde|\n
# Shift with the arrows selects, as in any macOS text view: by word with
# ⌥, to the start of the line with ⌘; → ends the selection at its end.
key shift-alt-left
expect compose_selection = regarde
snap reply-selection
key shift-cmd-left
expect compose_selection = Merci d'avance, je regarde
key right
expect compose_selection = 
expect compose_text ~ je regarde|\n
# ⌘A selects everything, → leaves the cursor at the end.
key cmd-a
expect compose_selection ~ wrote:
key right
expect compose_selection = 
# ⇧⌥↓ selects to the end of the paragraph, then of the next one at each
# press, as in macOS; ⇧⌥↑ comes back the same way.
key cmd-up
key shift-alt-down
expect compose_selection = Merci d'avance, je regarde
key shift-alt-down
expect compose_selection = Merci d'avance, je regarde\nAchill
snap reply-paragraphs
key shift-alt-up
expect compose_selection = Merci d'avance, je regarde\n
# The subject edits as a macOS field: ⌘A, ⌘C ⌘X ⌘V, ⇧⌥→ a word.
key shift-tab
expect compose_focus = subject
key cmd-a
expect compose_subject_selection ~ Re:
key cmd-c
expect pasteboard ~ Re:
key cmd-left
key shift-alt-right
expect compose_subject_selection = Re
snap subject-word
key cmd-a
key cmd-x
expect compose_subject = 
key cmd-v
expect compose_subject ~ Re:
key ret
expect compose_focus = body
# Back to the end of the text, for what follows.
key cmd-a
key right
expect compose_selection = 
# Another app (Kerlig, a grammar checker) works on the selected text
# through the accessibility API: the reply's text is the focused element,
# its selection is readable, and what the app writes back replaces it.
key shift-alt-left
expect ax_focused = true
expect ax_settable = true
expect compose_selection = Victor\n
expect ax_selected_text ~ Victor
axselect 8 6
expect compose_selection = avance
expect ax_selected_text = avance
axreplace AVANCE
expect compose_text ~ Merci d'AVANCE|, je regarde
expect compose_saved = true
axselect 8 6
axreplace avance
expect compose_text ~ Merci d'avance|, je regarde
# Saved after a pause of typing.
expect compose_saved = true
expect compose_lines > 3
snap reply-typed
# Escape: back to the mail, the draft kept; `r` resumes it.
key esc
expect composing = false
expect mode = NOR
expect flash ~ kept in Drafts
# The reply is in Drafts now; Return there reopens it.
key ;
key r
expect folder = Drafts
expect selected_subject ~ La facture de mars
snap drafts
key ret
expect composing = true
expect flash ~ resumed
expect compose_text ~ je regarde\nAchill
key esc
expect composing = false
# Back to the Inbox: `r` on the mail resumes it too.
key ;
key i
expect folder = Inbox
key r
expect composing = true
expect flash ~ resumed
expect compose_text ~ je regarde\nAchill
# ⌘⌫ abandons it, `z` gives it back with its text.
key cmd-del
expect composing = false
expect flash ~ abandoned
key z
expect composing = true
expect compose_text ~ je regarde\nAchill
# ⌘↩: the mail waits for the undo delay; `z` cancels it.
key cmd-ret
expect composing = false
expect flash ~ Sending in
expect sending_count = 1
expect undo_count = 1
key z
expect composing = true
expect flash ~ Sending cancelled
expect sending_count = 0
# ⇧⌘↩ asks where the conversation goes, the preselection marked; Escape
# goes back to the text without sending.
key shift-cmd-ret
expect overlay ~ choice
expect choice ~ Send, then file the conversation in
snap reply-send-then
key esc
expect composing = true
expect overlay = none
expect sending_count = 0
# A click on Waiting (the second row): sent after the delay; `z` cancels
# it, and the reply comes back with its choice.
key shift-cmd-ret
click menu:1
expect composing = false
expect flash ~ Sending in
key z
expect composing = true
expect compose_after = waiting
expect compose_after_line ~ After sending: Waiting
# ⌘↩ keeps that choice; the delay goes by: sent, filed in Waiting.
key cmd-ret
expect composing = false
wait 4500
expect flash ~ Sent · filed in Waiting
expect sending_count = 0
expect undo_count = 1
snap sent
# `z` undoes the filing, not the sending; the cursor goes back to the
# conversation brought back.
key z
expect flash ~ Undone: filing of the reply
expect selected_subject ~ La facture de mars
# The trial option, on the next conversation (back in the Inbox from
# Todo, so preselected for Todo): sent with ⇧⌘↩ then `s`, it stays in
# the Inbox.
key j
expect folder = Inbox
expect selected_subject ~ Rappel : le déménagement
key r
expect composing = true
expect compose_after = todo
type Une précision
key shift-cmd-ret
key s
expect composing = false
wait 4500
expect flash ~ Sent
expect flash !~ filed
expect folder = Inbox
expect selected_subject ~ Rappel : le déménagement
