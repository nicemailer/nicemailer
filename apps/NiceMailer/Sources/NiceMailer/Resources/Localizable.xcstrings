        }
      }
    },
    "NiceMailer finds the servers from the address. It asks for more only if it needs to.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer trouve les serveurs à partir de l’adresse. Il ne demande autre chose que s’il en a besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer findet die Server anhand der Adresse. Es fragt nur nach mehr, wenn es nötig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer encuentra los servidores a partir de la dirección. Solo pide más si lo necesita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer trova i server a partire dall'indirizzo. Chiede altro solo se serve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NiceMailer encontra os servidores a partir do endereço. Ele só pede mais se precisar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer vindt de servers aan de hand van het adres. Het vraagt alleen meer als het nodig is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer hittar servrarna utifrån adressen. Den frågar bara efter mer om det behövs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer finder serverne ud fra adressen. Den spørger kun om mere, hvis det er nødvendigt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer finner serverne ut fra adressen. Den spør bare om mer hvis det trengs."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer löytää palvelimet osoitteen perusteella. Se kysyy lisää vain tarvittaessa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer znajduje serwery na podstawie adresu. Prosi o więcej tylko w razie potrzeby."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer находит серверы по адресу. Он просит больше, только если это нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer знаходить сервери за адресою. Він просить більше, лише якщо це потрібно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailerはアドレスからサーバを見つけます。必要なときだけ追加の情報を尋ねます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 根据地址查找服务器。只有在需要时才会询问更多信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 根據位址尋找伺服器。只有在需要時才會詢問更多資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer는 주소로 서버를 찾습니다. 필요할 때만 더 묻습니다."
          }
        }
      }
    },
    "NiceMailer found no server to send mail from %@. Give the SMTP server, or add the account without sending for now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer n’a trouvé aucun serveur pour envoyer des mails depuis %@. Indiquez le serveur SMTP, ou ajoutez le compte sans envoi pour l’instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer hat keinen Server gefunden, um Mails von %@ zu senden. Gib den SMTP-Server an oder füge das Konto vorerst ohne Senden hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer no encontró ningún servidor para enviar correo desde %@. Indica el servidor SMTP, o añade la cuenta sin envío por ahora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer non ha trovato un server per inviare posta da %@. Indica il server SMTP, o aggiungi l'account senza invio per ora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NiceMailer não encontrou servidor para enviar e-mails de %@. Informe o servidor SMTP, ou adicione a conta sem envio por enquanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer vond geen server om mail te versturen vanaf %@. Geef de SMTP-server op, of voeg de account voorlopig zonder versturen toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer hittade ingen server för att skicka mejl från %@. Ange SMTP-servern, eller lägg till kontot utan sändning tills vidare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer fandt ingen server til at sende mail fra %@. Angiv SMTP-serveren, eller tilføj kontoen uden afsendelse indtil videre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer fant ingen server for å sende e-post fra %@. Oppgi SMTP-serveren, eller legg til kontoen uten sending inntil videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer ei löytänyt palvelinta postin lähettämiseen osoitteesta %@. Anna SMTP-palvelin tai lisää tili toistaiseksi ilman lähettämistä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer nie znalazł serwera do wysyłania poczty z %@. Podaj serwer SMTP albo dodaj konto na razie bez wysyłania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer не нашел сервер для отправки почты с %@. Укажите сервер SMTP или добавьте учетную запись пока без отправки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer не знайшов сервера для надсилання пошти з %@. Укажіть сервер SMTP або додайте обліковий запис поки без надсилання."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailerは%@からメールを送るサーバを見つけられませんでした。SMTPサーバを入力するか、当面は送信なしでアカウントを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 找不到从 %@ 发送邮件的服务器。请输入 SMTP 服务器，或暂时不带发送功能添加账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 找不到從 %@ 傳送郵件的伺服器。請輸入 SMTP 伺服器，或暫時不含傳送功能加入帳號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer가 %@에서 메일을 보낼 서버를 찾지 못했습니다. SMTP 서버를 입력하거나 당분간 보내기 없이 계정을 추가하십시오."
          }
        }
      }
    },
    "No server to send mail worked (%@). Check the SMTP server, or add the account without sending for now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur d’envoi n’a fonctionné (%@). Vérifiez le serveur SMTP, ou ajoutez le compte sans envoi pour l’instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Server zum Senden hat funktioniert (%@). Prüfe den SMTP-Server oder füge das Konto vorerst ohne Senden hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún servidor de envío funcionó (%@). Comprueba el servidor SMTP, o añade la cuenta sin envío por ahora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server di invio ha funzionato (%@). Verifica il server SMTP, o aggiungi l'account senza invio per ora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor de envio funcionou (%@). Verifique o servidor SMTP, ou adicione a conta sem envio por enquanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele verzendserver werkte (%@). Controleer de SMTP-server, of voeg de account voorlopig zonder versturen toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen server för sändning fungerade (%@). Kontrollera SMTP-servern, eller lägg till kontot utan sändning tills vidare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen afsendelsesserver virkede (%@). Kontrollér SMTP-serveren, eller tilføj kontoen uden afsendelse indtil videre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sendeserver fungerte (%@). Kontroller SMTP-serveren, eller legg til kontoen uten sending inntil videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään lähetyspalvelin ei toiminut (%@). Tarkista SMTP-palvelin tai lisää tili toistaiseksi ilman lähettämistä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden serwer wysyłania nie zadziałał (%@). Sprawdź serwer SMTP albo dodaj konto na razie bez wysyłania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один сервер отправки не сработал (%@). Проверьте сервер SMTP или добавьте учетную запись пока без отправки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден сервер надсилання не спрацював (%@). Перевірте сервер SMTP або додайте обліковий запис поки без надсилання."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信サーバがどれも機能しませんでした（%@）。SMTPサーバを確認するか、当面は送信なしでアカウントを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的发送服务器（%@）。请检查 SMTP 服务器，或暂时不带发送功能添加账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的傳送伺服器（%@）。請檢查 SMTP 伺服器，或暫時不含傳送功能加入帳號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동한 보내기 서버가 없습니다(%@). SMTP 서버를 확인하거나 당분간 보내기 없이 계정을 추가하십시오."
          }
        }
      }
    },
    "Other senders go through the Quarantine with their next mail.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres expéditeurs passeront par la Quarantine à leur prochain mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Absender gehen mit ihrer nächsten Mail durch die Quarantine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás remitentes pasan por la Quarantine con su próximo correo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri mittenti passano dalla Quarantine con la loro prossima mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros remetentes passam pela Quarantine no próximo e-mail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere afzenders gaan met hun volgende mail door de Quarantine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra avsändare går genom Quarantine med sitt nästa mejl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre afsendere går gennem Quarantine med deres næste mail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre avsendere går gjennom Quarantine med sin neste e-post."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut lähettäjät kulkevat Quarantinen kautta seuraavalla viestillään."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostali nadawcy przejdą przez Quarantine przy następnej wiadomości."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальные отправители пройдут через Quarantine со следующим письмом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші відправники пройдуть через Quarantine з наступним листом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの差出人は、次のメールでQuarantineを通ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他发件人的下一封邮件会经过 Quarantine。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他寄件人的下一封郵件會經過 Quarantine。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 보낸 사람은 다음 메일부터 Quarantine을 거칩니다."
          }
        }
      }
    },
