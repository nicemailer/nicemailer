    "NiceMailer may not read Contacts: allow it in System Settings, Privacy & Security, Contacts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer n'a pas accès aux Contacts : autorisez-le dans Réglages Système, Confidentialité et sécurité, Contacts"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer darf die Kontakte nicht lesen: Erlaube es in Systemeinstellungen, Datenschutz & Sicherheit, Kontakte"
          }
        },
        "es": {
          "stringUnit": {
