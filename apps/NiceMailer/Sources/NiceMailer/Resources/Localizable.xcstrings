    "%@ has no mail server (no MX record). Give the IMAP server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de serveur de mail (aucun enregistrement MX). Indiquez le serveur IMAP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen Mailserver (kein MX-Eintrag). Gib den IMAP-Server an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene servidor de correo (ningún registro MX). Indica el servidor IMAP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un server di posta (nessun record MX). Indica il server IMAP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem servidor de e-mail (nenhum registro MX). Informe o servidor IMAP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen mailserver (geen MX-record). Geef de IMAP-server op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen e-postserver (ingen MX-post). Ange IMAP-servern."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen mailserver (ingen MX-post). Angiv IMAP-serveren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen e-postserver (ingen MX-post). Oppgi IMAP-serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkotunnuksella %@ ei ole postipalvelinta (ei MX-tietuetta). Anna IMAP-palvelin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma serwera poczty (brak rekordu MX). Podaj serwer IMAP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ нет почтового сервера (нет записи MX). Укажите сервер IMAP."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ немає поштового сервера (немає запису MX). Укажіть сервер IMAP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはメールサーバがありません（MXレコードなし）。IMAPサーバを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有邮件服务器（没有 MX 记录）。请输入 IMAP 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有郵件伺服器（沒有 MX 記錄）。請輸入 IMAP 伺服器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 메일 서버가 없습니다(MX 레코드 없음). IMAP 서버를 입력하십시오."
          }
        }
      }
    },
    "%@ is not run by the provider of %@: NiceMailer does not send it your mailbox password. Enter the password of this SMTP server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas géré par le fournisseur de %@ : NiceMailer ne lui envoie pas le mot de passe de votre boîte. Saisissez le mot de passe de ce serveur SMTP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird nicht vom Anbieter von %2$@ betrieben: NiceMailer sendet ihm nicht das Passwort deines Postfachs. Gib das Passwort dieses SMTP-Servers ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no lo gestiona el proveedor de %2$@: NiceMailer no le envía la contraseña de tu buzón. Introduce la contraseña de este servidor SMTP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è gestito dal fornitore di %2$@: NiceMailer non gli invia la password della tua casella. Inserisci la password di questo server SMTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não é operado pelo provedor de %2$@: o NiceMailer não envia a ele a senha da sua caixa. Digite a senha deste servidor SMTP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wordt niet beheerd door de provider van %2$@: NiceMailer stuurt hem het wachtwoord van je mailbox niet. Voer het wachtwoord van deze SMTP-server in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drivs inte av leverantören för %2$@: NiceMailer skickar inte lösenordet till din brevlåda dit. Ange lösenordet för den här SMTP-servern."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drives ikke af udbyderen af %2$@: NiceMailer sender ikke adgangskoden til din postkasse dertil. Indtast adgangskoden til denne SMTP-server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drives ikke av leverandøren til %2$@: NiceMailer sender ikke passordet til postkassen din dit. Skriv inn passordet til denne SMTP-serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ei ole palveluntarjoajan %2$@ ylläpitämä: NiceMailer ei lähetä sille postilaatikkosi salasanaa. Anna tämän SMTP-palvelimen salasana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie jest obsługiwany przez dostawcę %2$@: NiceMailer nie wysyła mu hasła Twojej skrzynki. Wpisz hasło tego serwera SMTP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не принадлежит провайдеру %2$@: NiceMailer не отправляет ему пароль вашего ящика. Введите пароль этого SMTP-сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не належить провайдерові %2$@: NiceMailer не надсилає йому пароль вашої скриньки. Введіть пароль цього SMTP-сервера."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@のプロバイダが運用しているサーバではありません：NiceMailerはメールボックスのパスワードを送りません。このSMTPサーバのパスワードを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不由 %2$@ 的服务提供商运营：NiceMailer 不会向它发送你的邮箱密码。请输入此 SMTP 服务器的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不是由 %2$@ 的服務供應商營運：NiceMailer 不會向它傳送你的信箱密碼。請輸入此 SMTP 伺服器的密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@의 서비스 제공업체가 운영하지 않음: NiceMailer는 메일함 암호를 보내지 않습니다. 이 SMTP 서버의 암호를 입력하십시오."
          }
        }
      }
    },
    "%@ only accepts a sign-in NiceMailer does not support yet (OAuth2). Give another IMAP server if your provider has one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte qu’une connexion que NiceMailer ne gère pas encore (OAuth2). Indiquez un autre serveur IMAP si votre fournisseur en propose un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akzeptiert nur eine Anmeldung, die NiceMailer noch nicht unterstützt (OAuth2). Gib einen anderen IMAP-Server an, falls dein Anbieter einen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo acepta un inicio de sesión que NiceMailer aún no admite (OAuth2). Indica otro servidor IMAP si tu proveedor tiene uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accetta solo un accesso che NiceMailer non supporta ancora (OAuth2). Indica un altro server IMAP se il tuo fornitore ne ha uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só aceita um login que o NiceMailer ainda não suporta (OAuth2). Informe outro servidor IMAP se o seu provedor tiver um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepteert alleen een aanmelding die NiceMailer nog niet ondersteunt (OAuth2). Geef een andere IMAP-server op als je provider er een heeft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepterar bara en inloggning som NiceMailer inte stöder än (OAuth2). Ange en annan IMAP-server om din leverantör har en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepterer kun et login, som NiceMailer ikke understøtter endnu (OAuth2). Angiv en anden IMAP-server, hvis din udbyder har en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godtar bare en pålogging som NiceMailer ikke støtter ennå (OAuth2). Oppgi en annen IMAP-server hvis leverandøren din har en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hyväksyy vain kirjautumisen, jota NiceMailer ei vielä tue (OAuth2). Anna toinen IMAP-palvelin, jos palveluntarjoajallasi on sellainen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akceptuje tylko logowanie, którego NiceMailer jeszcze nie obsługuje (OAuth2). Podaj inny serwer IMAP, jeśli Twój dostawca go ma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принимает только вход, который NiceMailer пока не поддерживает (OAuth2). Укажите другой сервер IMAP, если он есть у вашего провайдера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ приймає лише вхід, який NiceMailer поки не підтримує (OAuth2). Укажіть інший сервер IMAP, якщо він є у вашого провайдера."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はNiceMailerがまだ対応していないサインイン方法（OAuth2）しか受け付けません。プロバイダに別のIMAPサーバがあれば入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只接受 NiceMailer 尚不支持的登录方式（OAuth2）。如果你的服务提供商有其他 IMAP 服务器，请输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只接受 NiceMailer 尚不支援的登入方式（OAuth2）。如果你的服務供應商有其他 IMAP 伺服器，請輸入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) NiceMailer가 아직 지원하지 않는 로그인 방식(OAuth2)만 받습니다. 서비스 제공업체에 다른 IMAP 서버가 있으면 입력하십시오."
          }
        }
      }
    },
