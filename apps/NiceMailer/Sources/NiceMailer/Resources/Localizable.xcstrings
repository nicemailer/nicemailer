    "The core was started by hand: stop it where it runs (Ctrl-C)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noyau a été lancé à la main : arrêtez-le là où il tourne (Ctrl-C)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kern wurde von Hand gestartet: Beende ihn dort, wo er läuft (Ctrl-C)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El núcleo se inició a mano: detenlo donde se ejecuta (Ctrl-C)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nucleo è stato avviato a mano: fermalo dove è in esecuzione (Ctrl-C)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O núcleo foi iniciado à mão: pare-o onde ele está rodando (Ctrl-C)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kern is met de hand gestart: stop hem waar hij draait (Ctrl-C)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kärnan startades för hand: stoppa den där den körs (Ctrl-C)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernen blev startet manuelt: stop den, hvor den kører (Ctrl-C)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjernen ble startet for hånd: stopp den der den kjører (Ctrl-C)"
          }
        }
      }
    },
    "The database of this folder cannot be read (%@). The current mailbox is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données de ce dossier est illisible (%@). La base actuelle est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank dieses Ordners kann nicht gelesen werden (%@). Das aktuelle Postfach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos de esta carpeta no se puede leer (%@). Se conserva el buzón actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database di questa cartella non è leggibile (%@). La casella attuale viene mantenuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados desta pasta não pode ser lido (%@). A caixa atual é mantida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database van deze map is onleesbaar (%@). De huidige mailbox blijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Databasen i den här mappen kan inte läsas (%@). Den aktuella brevlådan behålls."
          }
        },
        "da": {
