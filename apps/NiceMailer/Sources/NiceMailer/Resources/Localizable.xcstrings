    "%@ added: NiceMailer shows its mail and changes nothing on the server. Organize it from its page when you are ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajouté : NiceMailer affiche ses mails et ne change rien sur le serveur. Organisez-le depuis sa page quand vous le souhaitez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hinzugefügt: NiceMailer zeigt seine Mails und ändert nichts auf dem Server. Organisiere es auf seiner Seite, wenn du so weit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ añadida: NiceMailer muestra sus correos y no cambia nada en el servidor. Organízala desde su página cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aggiunto: NiceMailer mostra le sue mail e non cambia nulla sul server. Organizzalo dalla sua pagina quando sei pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionada: o NiceMailer mostra seus e-mails e não muda nada no servidor. Organize-a pela página dela quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toegevoegd: NiceMailer toont de mails en wijzigt niets op de server. Organiseer de account vanaf de pagina ervan wanneer je zover bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillagt: NiceMailer visar mejlen och ändrar ingenting på servern. Organisera kontot från dess sida när du är redo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tilføjet: NiceMailer viser mailene og ændrer intet på serveren. Organisér kontoen fra dens side, når du er klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagt til: NiceMailer viser e-postene og endrer ingenting på serveren. Organiser kontoen fra siden dens når du er klar."
          }
        }
      }
    },
