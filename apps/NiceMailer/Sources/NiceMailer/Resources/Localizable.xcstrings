    "No account can send: add an [smtp] server to one in accounts.toml": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ne peut envoyer : ajoutez un serveur [smtp] à l'un d'eux dans accounts.toml"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto kann senden: Füge einem in accounts.toml einen [smtp]-Server hinzu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta puede enviar: añade un servidor [smtp] a una en accounts.toml"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account può inviare: aggiungi un server [smtp] a uno in accounts.toml"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta pode enviar: adicione um servidor [smtp] a uma em accounts.toml"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account kan versturen: voeg in accounts.toml een [smtp]-server toe aan een account"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto kan skicka: lägg till en [smtp]-server i ett av dem i accounts.toml"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto kan sende: føj en [smtp]-server til en af dem i accounts.toml"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto kan sende: legg til en [smtp]-server i en av dem i accounts.toml"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään tili ei voi lähettää: lisää jollekin [smtp]-palvelin tiedostossa accounts.toml"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne konto nie może wysyłać: dodaj serwer [smtp] do jednego z nich w accounts.toml"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна учетная запись не может отправлять: добавьте сервер [smtp] одной из них в accounts.toml"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден обліковий запис не може надсилати: додайте сервер [smtp] одному з них у accounts.toml"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できるアカウントがありません：accounts.tomlでいずれかに[smtp]サーバを追加してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可以发送的账户：请在 accounts.toml 中为其中一个添加 [smtp] 服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可以傳送的帳號：請在 accounts.toml 中為其中一個加入 [smtp] 伺服器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 수 있는 계정이 없음: accounts.toml에서 계정 중 하나에 [smtp] 서버를 추가하십시오"
          }
        }
      }
    },
