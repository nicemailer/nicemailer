    "upgrade it and use it (older versions of NiceMailer will no longer open it: copy the folder first to keep them able to)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la mettre à jour et l’utiliser (les versions plus anciennes de NiceMailer ne l’ouvriront plus : copiez d’abord le dossier pour les garder capables de l’ouvrir)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "aktualisieren und verwenden (ältere Versionen von NiceMailer werden es nicht mehr öffnen: Kopiere zuerst den Ordner, damit sie es weiter können)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "actualizarlo y usarlo (las versiones anteriores de NiceMailer ya no lo abrirán: copia primero la carpeta para que puedan seguir haciéndolo)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "aggiornala e usala (le versioni precedenti di NiceMailer non la apriranno più: copia prima la cartella perché possano continuare a farlo)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "atualizá-la e usá-la (as versões anteriores do NiceMailer não vão mais abri-la: copie a pasta antes para que continuem podendo)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijwerken en gebruiken (oudere versies van NiceMailer openen hem niet meer: kopieer eerst de map zodat ze het nog kunnen)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "uppgradera och använd den (äldre versioner av NiceMailer kommer inte längre att öppna den: kopiera mappen först så att de fortfarande kan)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "opgradér og brug den (ældre versioner af NiceMailer vil ikke længere åbne den: kopiér mappen først, så de stadig kan)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "oppgrader og bruk den (eldre versjoner av NiceMailer vil ikke lenger åpne den: kopier mappen først så de fortsatt kan)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "päivitä ja käytä sitä (NiceMailerin vanhemmat versiot eivät enää avaa sitä: kopioi kansio ensin, jotta ne voivat yhä)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zaktualizuj ją i używaj (starsze wersje NiceMailer nie otworzą jej już: najpierw skopiuj folder, aby nadal mogły)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "обновить и использовать его (старые версии NiceMailer больше не откроют его: сначала скопируйте папку, чтобы они могли и дальше)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "оновити й використовувати її (старші версії NiceMailer більше не відкриють її: спершу скопіюйте теку, щоб вони могли й далі)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップグレードして使用（古いバージョンのNiceMailerでは開けなくなります：開けるようにしておくには、先にフォルダをコピーしてください）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级并使用（旧版本的 NiceMailer 将无法再打开它：请先拷贝文件夹，让它们仍然可以打开）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級並使用（舊版 NiceMailer 將無法再打開它：請先拷貝檔案夾，讓它們仍可打開）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업그레이드하고 사용(이전 버전의 NiceMailer에서는 더 이상 열 수 없습니다: 계속 열 수 있게 하려면 먼저 폴더를 복사하십시오)"
          }
        }
      }
    },
