    "The original message is not stored on this Mac: this document was made from the mail database, and cannot be checked against the original.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message original n’est pas conservé sur ce Mac : ce document a été établi à partir de la base des mails et ne peut pas être vérifié par rapport à l’original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originalnachricht ist auf diesem Mac nicht gespeichert: Dieses Dokument wurde aus der Mail-Datenbank erstellt und kann nicht mit dem Original abgeglichen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje original no se guarda en este Mac: este documento se hizo a partir de la base de correos y no se puede cotejar con el original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio originale non è conservato su questo Mac: questo documento è stato ricavato dal database delle mail e non può essere confrontato con l'originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem original não está guardada neste Mac: este documento foi feito a partir do banco de e-mails e não pode ser conferido com o original."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het originele bericht is niet op deze Mac bewaard: dit document is gemaakt uit de maildatabase en kan niet met het origineel worden vergeleken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalmeddelandet sparas inte på den här Macen: dokumentet skapades från mejldatabasen och kan inte jämföras med originalet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den oprindelige meddelelse gemmes ikke på denne Mac: dette dokument blev lavet ud fra maildatabasen og kan ikke sammenholdes med originalen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den opprinnelige meldingen lagres ikke på denne Macen: dette dokumentet ble laget ut fra e-postdatabasen og kan ikke sammenlignes med originalen."
          }
        }
      }
    },
