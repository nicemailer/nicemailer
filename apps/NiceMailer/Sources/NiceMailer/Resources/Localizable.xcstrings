    "NiceMailer could not connect to %@: %@. Check the IMAP server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer n’a pas pu se connecter à %@ : %@. Vérifiez le serveur IMAP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer konnte keine Verbindung zu %1$@ herstellen: %2$@. Prüfe den IMAP-Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
