    "%@ added: NiceMailer shows its mail and changes nothing on the server. Organize it from its page when you are ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajouté : NiceMailer affiche ses mails et ne change rien sur le serveur. Organisez-le depuis sa page quand vous le souhaitez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hinzugefügt: NiceMailer zeigt seine Mails und ändert nichts auf dem Server. Organisiere es auf seiner Seite, wenn du so weit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ añadida: NiceMailer muestra sus correos y no cambia nada en el servidor. Organízala desde su página cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aggiunto: NiceMailer mostra le sue mail e non cambia nulla sul server. Organizzalo dalla sua pagina quando sei pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionada: o NiceMailer mostra seus e-mails e não muda nada no servidor. Organize-a pela página dela quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toegevoegd: NiceMailer toont de mails en wijzigt niets op de server. Organiseer de account vanaf de pagina ervan wanneer je zover bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tillagt: NiceMailer visar mejlen och ändrar ingenting på servern. Organisera kontot från dess sida när du är redo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tilføjet: NiceMailer viser mailene og ændrer intet på serveren. Organisér kontoen fra dens side, når du er klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lagt til: NiceMailer viser e-postene og endrer ingenting på serveren. Organiser kontoen fra siden dens når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lisätty: NiceMailer näyttää sen viestit eikä muuta mitään palvelimella. Järjestä tili sen sivulta, kun olet valmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano %@: NiceMailer pokazuje wiadomości i niczego nie zmienia na serwerze. Uporządkuj konto z jego strony, kiedy zechcesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ добавлена: NiceMailer показывает письма и ничего не меняет на сервере. Упорядочьте учетную запись с ее страницы, когда захотите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ додано: NiceMailer показує листи й нічого не змінює на сервері. Упорядкуйте обліковий запис з його сторінки, коли захочете."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を追加しました：NiceMailerはメールを表示しますが、サーバでは何も変更しません。準備ができたら、そのページからアカウントを整理してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 %@：NiceMailer 显示其邮件，不在服务器上做任何更改。准备好后，请在其页面上整理账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入 %@：NiceMailer 顯示其郵件，不在伺服器上做任何更改。準備好後，請在其頁面上整理帳號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 추가함: NiceMailer는 메일을 보여 주며 서버에서 아무것도 변경하지 않습니다. 준비되면 해당 페이지에서 계정을 정리하십시오."
          }
        }
      }
    },
    "%@ is organized: new mail is screened from now on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est organisé : les nouveaux mails sont triés dès maintenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist organisiert: Neue Mails werden ab jetzt sortiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está organizada: los correos nuevos se clasifican desde ahora."
          }
        },
        "it": {
          "stringUnit": {
