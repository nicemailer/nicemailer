            "value": "Ainda nenhum grupo: g adiciona o remetente de um e-mail a um grupo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen groep: g voegt de afzender van een mail toe aan een groep"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen grupp än: g lägger till avsändaren av ett mejl i en grupp"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen gruppe endnu: g føjer afsenderen af en mail til en gruppe"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen gruppe ennå: g legger avsenderen av en e-post til i en gruppe"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä ryhmiä: g lisää viestin lähettäjän ryhmään"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze brak grup: g dodaje nadawcę wiadomości do grupy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Групп пока нет: g добавляет отправителя письма в группу"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Груп поки немає: g додає відправника листа до групи"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはまだありません：gでメールの差出人をグループに追加します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有群组：g 会把邮件的发件人加入一个群组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有群組：g 會把郵件的寄件人加入一個群組"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 그룹 없음: g를 누르면 메일의 보낸 사람을 그룹에 추가합니다"
          }
        }
      }
    },
