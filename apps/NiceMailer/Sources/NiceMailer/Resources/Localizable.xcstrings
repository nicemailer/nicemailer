        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorterar dina mejl i mapparna nedan. %1$@ skapas på servern: %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorterer dine mails i mapperne nedenfor. %1$@ oprettes på serveren: %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorterer e-postene dine i mappene nedenfor. %1$@ opprettes på serveren: %2$@."
          }
        }
      }
    },
    "NiceMailer sorts your mail into the folders below. They all exist already: none is created.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer range vos mails dans les dossiers ci-dessous. Ils existent tous déjà : aucun n’est créé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sortiert deine Mails in die Ordner unten. Sie existieren alle schon: Keiner wird angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer ordena tus correos en las carpetas de abajo. Ya existen todas: no se crea ninguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer smista le tue mail nelle cartelle qui sotto. Esistono già tutte: nessuna viene creata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O NiceMailer organiza seus e-mails nas pastas abaixo. Todas já existem: nenhuma é criada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorteert je mails in de mappen hieronder. Ze bestaan allemaal al: er wordt er geen aangemaakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorterar dina mejl i mapparna nedan. Alla finns redan: ingen skapas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer sorterer dine mails i mapperne nedenfor. De findes allerede alle: ingen oprettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
