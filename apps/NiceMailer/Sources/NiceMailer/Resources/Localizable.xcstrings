    "This mailbox was created by an early development version of NiceMailer (%@ missing): it cannot be upgraded. The current mailbox is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base a été créée par une version de développement ancienne de NiceMailer (%@ absent) : elle ne peut pas être mise à jour. La base actuelle est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Postfach wurde von einer frühen Entwicklungsversion von NiceMailer angelegt (%@ fehlt): Es kann nicht aktualisiert werden. Das aktuelle Postfach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este buzón lo creó una versión de desarrollo temprana de NiceMailer (falta %@): no se puede actualizar. Se conserva el buzón actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa casella è stata creata da una versione di sviluppo iniziale di NiceMailer (manca %@): non può essere aggiornata. La casella attuale viene mantenuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caixa foi criada por uma versão de desenvolvimento antiga do NiceMailer (falta %@): não pode ser atualizada. A caixa atual é mantida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze mailbox is gemaakt door een vroege ontwikkelversie van NiceMailer (%@ ontbreekt): hij kan niet worden bijgewerkt. De huidige mailbox blijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här brevlådan skapades av en tidig utvecklingsversion av NiceMailer (%@ saknas): den kan inte uppgraderas. Den aktuella brevlådan behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne postkasse blev oprettet af en tidlig udviklingsversion af NiceMailer (%@ mangler): den kan ikke opgraderes. Den aktuelle postkasse bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne postkassen ble opprettet av en tidlig utviklingsversjon av NiceMailer (%@ mangler): den kan ikke oppgraderes. Den gjeldende postkassen beholdes."
          }
        }
      }
    },
    "This mailbox was written by a newer version of NiceMailer (data format %lld; this one reads %lld): update NiceMailer to open it. The current mailbox is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base a été écrite par une version plus récente de NiceMailer (format de données %1$lld ; celle-ci lit le %2$lld) : mettez NiceMailer à jour pour l’ouvrir. La base actuelle est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Postfach wurde von einer neueren Version von NiceMailer geschrieben (Datenformat %1$lld; diese liest %2$lld): Aktualisiere NiceMailer, um es zu öffnen. Das aktuelle Postfach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este buzón lo escribió una versión más reciente de NiceMailer (formato de datos %1$lld; esta lee %2$lld): actualiza NiceMailer para abrirlo. Se conserva el buzón actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa casella è stata scritta da una versione più recente di NiceMailer (formato dati %1$lld; questa legge %2$lld): aggiorna NiceMailer per aprirla. La casella attuale viene mantenuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caixa foi escrita por uma versão mais recente do NiceMailer (formato de dados %1$lld; esta lê %2$lld): atualize o NiceMailer para abri-la. A caixa atual é mantida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze mailbox is geschreven door een nieuwere versie van NiceMailer (gegevensformaat %1$lld; deze leest %2$lld): werk NiceMailer bij om hem te openen. De huidige mailbox blijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här brevlådan skrevs av en nyare version av NiceMailer (dataformat %1$lld; den här läser %2$lld): uppdatera NiceMailer för att öppna den. Den aktuella brevlådan behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne postkasse blev skrevet af en nyere version af NiceMailer (dataformat %1$lld; denne læser %2$lld): opdater NiceMailer for at åbne den. Den aktuelle postkasse bevares."
          }
        },
        "nb": {
