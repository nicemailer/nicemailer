    "Images are never loaded in Junk, Quarantine or Banned": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images ne sont jamais chargées dans Junk, Quarantine ou Banned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden in Junk, Quarantine und Banned nie geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes nunca se cargan en Junk, Quarantine o Banned"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini non vengono mai caricate in Junk, Quarantine o Banned"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens nunca são carregadas em Junk, Quarantine ou Banned"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingen worden nooit geladen in Junk, Quarantine of Banned"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder läses aldrig in i Junk, Quarantine eller Banned"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder indlæses aldrig i Junk, Quarantine eller Banned"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder lastes aldri inn i Junk, Quarantine eller Banned"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvia ei koskaan ladata kansioissa Junk, Quarantine tai Banned"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazki nigdy nie są wczytywane w Junk, Quarantine ani Banned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения никогда не загружаются в Junk, Quarantine и Banned"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення ніколи не завантажуються в Junk, Quarantine і Banned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Junk、Quarantine、Bannedでは画像を読み込みません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Junk、Quarantine 和 Banned 中从不载入图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Junk、Quarantine 和 Banned 中絕不載入影像"
          }
