          "stringUnit": {
            "state": "translated",
            "value": "Junk, Quarantine, Banned에서는 이미지를 절대 불러오지 않습니다"
          }
        }
      }
    },
    "Images loaded for this conversation only: %@ is not authenticated": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images chargées pour cette conversation seulement : %@ n'est pas authentifié"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder nur für diese Konversation geladen: %@ ist nicht authentifiziert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes cargadas solo para esta conversación: %@ no está autenticado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini caricate solo per questa conversazione: %@ non è autenticato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens carregadas só para esta conversa: %@ não está autenticado"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingen alleen voor dit gesprek geladen: %@ is niet geverifieerd"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder inlästa bara för den här konversationen: %@ är inte autentiserad"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder indlæst kun for denne samtale: %@ er ikke godkendt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder lastet inn bare for denne samtalen: %@ er ikke autentisert"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat ladattu vain tähän keskusteluun: %@ ei ole todennettu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazki wczytane tylko dla tej rozmowy: %@ nie jest uwierzytelniony"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения загружены только для этого разговора: %@ не прошел проверку подлинности"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення завантажено лише для цієї розмови: %@ не пройшов автентифікацію"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話に限って画像を読み込みました：%@は認証されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为此对话载入了图像：%@ 未通过认证"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為此對話載入了影像：%@ 未通過認證"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에 한해 이미지를 불러옴: %@은(는) 인증되지 않았습니다"
          }
        }
      }
    },
    "In Quarantine, a mail can only be moved or flagged": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En Quarantine, un mail se déplace ou reçoit un drapeau, rien d'autre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Quarantine kann eine Mail nur verschoben oder markiert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Quarantine, un correo solo se puede mover o marcar"
          }
        },
        "it": {
