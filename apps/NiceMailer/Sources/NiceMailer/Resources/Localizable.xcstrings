    "Older versions of NiceMailer will no longer open it: copy the folder first to keep them able to.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions plus anciennes de NiceMailer ne l’ouvriront plus : copiez d’abord le dossier pour les garder capables de l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Versionen von NiceMailer werden es nicht mehr öffnen: Kopiere zuerst den Ordner, damit sie es weiter können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones anteriores de NiceMailer ya no lo abrirán: copia primero la carpeta para que puedan seguir haciéndolo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni precedenti di NiceMailer non la apriranno più: copia prima la cartella perché possano continuare a farlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões anteriores do NiceMailer não vão mais abri-la: copie a pasta antes para que continuem podendo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere versies van NiceMailer openen hem niet meer: kopieer eerst de map zodat ze het nog kunnen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äldre versioner av NiceMailer kommer inte längre att öppna den: kopiera mappen först så att de fortfarande kan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ældre versioner af NiceMailer vil ikke længere åbne den: kopiér mappen først, så de stadig kan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldre versjoner av NiceMailer vil ikke lenger åpne den: kopier mappen først så de fortsatt kan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailerin vanhemmat versiot eivät enää avaa sitä: kopioi kansio ensin, jotta ne voivat yhä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze wersje NiceMailer nie otworzą jej już: najpierw skopiuj folder, aby nadal mogły."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые версии NiceMailer больше не откроют его: сначала скопируйте папку, чтобы они могли и дальше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старші версії NiceMailer більше не відкриють її: спершу скопіюйте теку, щоб вони могли й далі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いバージョンのNiceMailerでは開けなくなります：開けるようにしておくには、先にフォルダをコピーしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本的 NiceMailer 将无法再打开它：请先拷贝文件夹，让它们仍然可以打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版 NiceMailer 將無法再打開它：請先拷貝檔案夾，讓它們仍可打開。"
          }
        },
        "ko": {
          "stringUnit": {
