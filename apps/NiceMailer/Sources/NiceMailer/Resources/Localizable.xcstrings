    "The core was started by hand: stop it where it runs (Ctrl-C)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le noyau a été lancé à la main : arrêtez-le là où il tourne (Ctrl-C)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kern wurde von Hand gestartet: Beende ihn dort, wo er läuft (Ctrl-C)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El núcleo se inició a mano: detenlo donde se ejecuta (Ctrl-C)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nucleo è stato avviato a mano: fermalo dove è in esecuzione (Ctrl-C)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O núcleo foi iniciado à mão: pare-o onde ele está rodando (Ctrl-C)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kern is met de hand gestart: stop hem waar hij draait (Ctrl-C)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kärnan startades för hand: stoppa den där den körs (Ctrl-C)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernen blev startet manuelt: stop den, hvor den kører (Ctrl-C)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjernen ble startet for hånd: stopp den der den kjører (Ctrl-C)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ydin käynnistettiin käsin: pysäytä se siellä, missä se on käynnissä (Ctrl-C)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rdzeń uruchomiono ręcznie: zatrzymaj go tam, gdzie działa (Ctrl-C)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядро запущено вручную: остановите его там, где оно работает (Ctrl-C)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядро запущено вручну: зупиніть його там, де воно працює (Ctrl-C)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コアは手動で起動されています：動いている場所で停止してください（Ctrl-C）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核是手动启动的：请在它运行的地方停止它（Ctrl-C）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心是手動啟動的：請在它執行的地方停止它（Ctrl-C）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코어가 수동으로 시작됨: 실행 중인 곳에서 중지하십시오(Ctrl-C)"
          }
        }
      }
    },
    "The database of this folder cannot be read (%@). The current mailbox is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données de ce dossier est illisible (%@). La base actuelle est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank dieses Ordners kann nicht gelesen werden (%@). Das aktuelle Postfach bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos de esta carpeta no se puede leer (%@). Se conserva el buzón actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database di questa cartella non è leggibile (%@). La casella attuale viene mantenuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados desta pasta não pode ser lido (%@). A caixa atual é mantida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De database van deze map is onleesbaar (%@). De huidige mailbox blijft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Databasen i den här mappen kan inte läsas (%@). Den aktuella brevlådan behålls."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Databasen i denne mappe kan ikke læses (%@). Den aktuelle postkasse bevares."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Databasen i denne mappen kan ikke leses (%@). Den gjeldende postkassen beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kansion tietokantaa ei voi lukea (%@). Nykyinen postilaatikko säilyy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać bazy danych tego folderu (%@). Obecna skrzynka zostaje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу данных этой папки нельзя прочитать (%@). Текущий почтовый ящик сохранен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних цієї теки не можна прочитати (%@). Поточну поштову скриньку збережено."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダのデータベースを読めません（%@）。現在のメールボックスを維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此文件夹的数据库（%@）。保留当前邮箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此檔案夾的資料庫（%@）。保留目前的信箱。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
