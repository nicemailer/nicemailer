          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer har brug for din tilladelse til at køre sin kerne: tillad det i Systemindstillinger > Generelt > Login-emner"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer trenger tillatelsen din for å kjøre kjernen sin: tillat det i Systeminnstillinger > Generelt > Påloggingsobjekter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer tarvitsee lupasi ytimensä ajamiseen: salli se kohdassa Järjestelmäasetukset > Yleiset > Kirjautumiskohteet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer potrzebuje Twojej zgody, aby uruchomić swój rdzeń: zezwól w Ustawieniach systemowych > Ogólne > Rzeczy otwierane podczas logowania"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer нужно ваше разрешение, чтобы запускать ядро: разрешите это в Системных настройках > Основные > Объекты входа"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer потребує вашого дозволу, щоб запускати ядро: дозвольте це в Системних параметрах > Загальні > Елементи входу"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailerがコアを動かすには許可が必要です：システム設定 > 一般 > ログイン項目で許可してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 需要你的许可才能运行其内核：请在“系统设置”>“通用”>“登录项”中允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer 需要你的許可才能執行其核心：請在「系統設定」>「一般」>「登入項目」中允許"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NiceMailer가 코어를 실행하려면 허가가 필요함: 시스템 설정 > 일반 > 로그인 항목에서 허용하십시오"
          }
        }
      }
    },
