    "To confirm calls, allow NiceMailer in System Settings › Privacy & Security › Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour confirmer les appels, autorisez NiceMailer dans Réglages Système › Confidentialité et sécurité › Accessibilité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Anrufe zu bestätigen, erlaube NiceMailer in Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen"
          }
        },
        "es": {
          "stringUnit": {
