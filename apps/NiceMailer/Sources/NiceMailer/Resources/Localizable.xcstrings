          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen mailserver (ingen MX-post). Angiv IMAP-serveren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen e-postserver (ingen MX-post). Oppgi IMAP-serveren."
          }
        }
      }
    },
    "%@ is not run by the provider of %@: NiceMailer does not send it your mailbox password. Enter the password of this SMTP server.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas géré par le fournisseur de %@ : NiceMailer ne lui envoie pas le mot de passe de votre boîte. Saisissez le mot de passe de ce serveur SMTP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird nicht vom Anbieter von %2$@ betrieben: NiceMailer sendet ihm nicht das Passwort deines Postfachs. Gib das Passwort dieses SMTP-Servers ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no lo gestiona el proveedor de %2$@: NiceMailer no le envía la contraseña de tu buzón. Introduce la contraseña de este servidor SMTP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è gestito dal fornitore di %2$@: NiceMailer non gli invia la password della tua casella. Inserisci la password di questo server SMTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não é operado pelo provedor de %2$@: o NiceMailer não envia a ele a senha da sua caixa. Digite a senha deste servidor SMTP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wordt niet beheerd door de provider van %2$@: NiceMailer stuurt hem het wachtwoord van je mailbox niet. Voer het wachtwoord van deze SMTP-server in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drivs inte av leverantören för %2$@: NiceMailer skickar inte lösenordet till din brevlåda dit. Ange lösenordet för den här SMTP-servern."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drives ikke af udbyderen af %2$@: NiceMailer sender ikke adgangskoden til din postkasse dertil. Indtast adgangskoden til denne SMTP-server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drives ikke av leverandøren til %2$@: NiceMailer sender ikke passordet til postkassen din dit. Skriv inn passordet til denne SMTP-serveren."
          }
        }
      }
    },
    "%@ only accepts a sign-in NiceMailer does not support yet (OAuth2). Give another IMAP server if your provider has one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte qu’une connexion que NiceMailer ne gère pas encore (OAuth2). Indiquez un autre serveur IMAP si votre fournisseur en propose un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akzeptiert nur eine Anmeldung, die NiceMailer noch nicht unterstützt (OAuth2). Gib einen anderen IMAP-Server an, falls dein Anbieter einen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo acepta un inicio de sesión que NiceMailer aún no admite (OAuth2). Indica otro servidor IMAP si tu proveedor tiene uno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accetta solo un accesso che NiceMailer non supporta ancora (OAuth2). Indica un altro server IMAP se il tuo fornitore ne ha uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só aceita um login que o NiceMailer ainda não suporta (OAuth2). Informe outro servidor IMAP se o seu provedor tiver um."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepteert alleen een aanmelding die NiceMailer nog niet ondersteunt (OAuth2). Geef een andere IMAP-server op als je provider er een heeft."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepterar bara en inloggning som NiceMailer inte stöder än (OAuth2). Ange en annan IMAP-server om din leverantör har en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accepterer kun et login, som NiceMailer ikke understøtter endnu (OAuth2). Angiv en anden IMAP-server, hvis din udbyder har en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godtar bare en pålogging som NiceMailer ikke støtter ennå (OAuth2). Oppgi en annen IMAP-server hvis leverandøren din har en."
          }
        }
      }
    },
