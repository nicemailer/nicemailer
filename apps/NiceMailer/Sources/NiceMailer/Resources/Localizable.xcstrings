    "Organizing it creates the folders NiceMailer needs, can archive old mail, and screens new mail for real. The mail there now is not screened, and is not downloaded again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’organiser crée les dossiers dont NiceMailer a besoin, peut archiver les anciens mails, et trie vraiment les nouveaux. Les mails déjà là ne sont pas triés, ni téléchargés à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisieren legt die Ordner an, die NiceMailer braucht, kann alte Mails archivieren und sortiert neue Mails wirklich. Die Mails, die jetzt dort sind, werden nicht sortiert und nicht erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizarla crea las carpetas que NiceMailer necesita, puede archivar los correos antiguos y clasifica de verdad los nuevos. Los correos que ya están no se clasifican ni se descargan de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizzarlo crea le cartelle che servono a NiceMailer, può archiviare le mail vecchie e smista davvero quelle nuove. Le mail già presenti non vengono smistate né riscaricate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizá-la cria as pastas de que o NiceMailer precisa, pode arquivar os e-mails antigos e tria de verdade os novos. Os e-mails que já estão lá não são triados nem baixados de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiseren maakt de mappen aan die NiceMailer nodig heeft, kan oude mail archiveren en sorteert nieuwe mail echt. De mail die er nu staat wordt niet gesorteerd en niet opnieuw gedownload."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att organisera det skapar mapparna som NiceMailer behöver, kan arkivera gamla mejl och sorterar nya mejl på riktigt. Mejlen som finns där nu sorteras inte och hämtas inte igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At organisere den opretter de mapper, NiceMailer har brug for, kan arkivere gamle mails og sorterer nye mails for alvor. De mails, der er der nu, sorteres ikke og hentes ikke igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å organisere den oppretter mappene NiceMailer trenger, kan arkivere gamle e-poster og sorterer nye e-poster på ordentlig. E-postene som er der nå, sorteres ikke og lastes ikke ned igjen."
          }
        }
      }
    },
    "“%@” is chosen for several roles (%@): choose one folder per role.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est choisi pour plusieurs rôles (%@) : choisissez un dossier par rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist für mehrere Rollen gewählt (%2$@): Wähle einen Ordner pro Rolle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está elegida para varios papeles (%2$@): elige una carpeta por papel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è scelta per più ruoli (%2$@): scegli una cartella per ruolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” foi escolhida para vários papéis (%2$@): escolha uma pasta por papel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ is gekozen voor meerdere rollen (%2$@): kies één map per rol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” är vald för flera roller (%2$@): välj en mapp per roll."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” er valgt til flere roller (%2$@): vælg én mappe pr. rolle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» er valgt for flere roller (%2$@): velg én mappe per rolle."
          }
        }
      }
    },
