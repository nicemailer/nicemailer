            "value": "%@ is georganiseerd: nieuwe mail wordt vanaf nu gesorteerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är organiserat: nya mejl sorteras från och med nu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er organiseret: nye mails sorteres fra nu af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er organisert: nye e-poster sorteres fra nå av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on järjestetty: uudet viestit lajitellaan tästä lähtien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest uporządkowane: nowe wiadomości są sortowane od teraz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
