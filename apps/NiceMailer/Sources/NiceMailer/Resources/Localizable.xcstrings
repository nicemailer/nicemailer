    "Only look for now: change nothing on the server": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement regarder pour l’instant : ne rien changer sur le serveur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorerst nur ansehen: auf dem Server nichts ändern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mirar por ahora: no cambiar nada en el servidor"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo guardare per ora: non cambiare nulla sul server"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só olhar por enquanto: não mudar nada no servidor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorlopig alleen kijken: niets wijzigen op de server"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara titta tills vidare: ändra ingenting på servern"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kigge indtil videre: ændr intet på serveren"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare se inntil videre: ikke endre noe på serveren"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain katselu toistaiseksi: älä muuta mitään palvelimella"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie tylko oglądaj: nic nie zmieniaj na serwerze"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока только смотреть: ничего не менять на сервере"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки лише дивитися: нічого не змінювати на сервері"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当面は見るだけ：サーバでは何も変更しない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时只查看：不在服务器上做任何更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時只檢視：不在伺服器上做任何更改"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당분간 보기만: 서버에서 아무것도 변경하지 않음"
          }
        }
      }
    },
