    "The people you have written to (%lld) arrive straight in the Inbox.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes à qui vous avez déjà écrit (%lld) arriveront directement dans la boîte de réception."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Personen, denen du geschrieben hast (%lld), kommen direkt in den Posteingang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas a las que escribiste (%lld) llegan directamente a la bandeja de entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone a cui hai scritto (%lld) arrivano direttamente in Posta in arrivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas para quem você escreveu (%lld) chegam direto na caixa de entrada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen naar wie je hebt geschreven (%lld) komen direct in de inkomende post."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personerna du har skrivit till (%lld) hamnar direkt i inkorgen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De personer, du har skrevet til (%lld), kommer direkte i indbakken."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Personene du har skrevet til (%lld), kommer rett i innboksen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilöt, joille olet kirjoittanut (%lld), tulevat suoraan saapuneisiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, z którymi korespondujesz (%lld), trafiają prosto do skrzynki odbiorczej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди, с которыми вы переписывались (%lld), попадают прямо во входящие."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди, з якими ви листувалися (%lld), потрапляють просто у вхідні."
          }
        },
        "ja": {
          "stringUnit": {
