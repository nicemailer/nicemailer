    "The password of %@ was saved for another server (%@ on %@): give it again to confirm %@ on %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe de %1$@ a été enregistré pour un autre serveur (%2$@ sur %3$@) : saisissez-le à nouveau pour confirmer %4$@ sur %5$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
