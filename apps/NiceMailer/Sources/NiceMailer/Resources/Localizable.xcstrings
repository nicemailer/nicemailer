    "%@ refused your mailbox password (%@): it needs a password of its own, such as an app password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé le mot de passe de votre boîte (%@) : il lui faut son propre mot de passe, par exemple un mot de passe d’application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat das Passwort deines Postfachs abgelehnt (%2$@): Es braucht ein eigenes Passwort, etwa ein App-Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rechazó la contraseña de tu buzón (%2$@): necesita una contraseña propia, como una contraseña de aplicación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha rifiutato la password della tua casella (%2$@): ne serve una propria, come una password per app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou a senha da sua caixa (%2$@): ele precisa de uma senha própria, como uma senha de app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ weigerde het wachtwoord van je mailbox (%2$@): het heeft een eigen wachtwoord nodig, zoals een appwachtwoord."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avvisade lösenordet till din brevlåda (%2$@): den behöver ett eget lösenord, till exempel ett applösenord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
