          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ упорядковано: нові листи сортуються від цього моменту."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を整理しました：今後の新着メールは仕分けされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已整理：从现在起新邮件会被分拣。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已整理：從現在起新郵件會被分類。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 정리함: 이제부터 새 메일이 분류됩니다."
          }
        }
      }
    },
    "A folder chosen here keeps its mail; a new folder is created empty.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier choisi ici garde ses mails ; un nouveau dossier est créé vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hier gewählter Ordner behält seine Mails; ein neuer Ordner wird leer angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta elegida aquí conserva sus correos; una carpeta nueva se crea vacía."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartella scelta qui mantiene le sue mail; una cartella nuova viene creata vuota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta escolhida aqui mantém seus e-mails; uma pasta nova é criada vazia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hier gekozen map houdt zijn mails; een nieuwe map wordt leeg aangemaakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mapp som väljs här behåller sina mejl; en ny mapp skapas tom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En mappe, der vælges her, beholder sine mails; en ny mappe oprettes tom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En mappe som velges her, beholder e-postene sine; en ny mappe opprettes tom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä valittu kansio säilyttää viestinsä; uusi kansio luodaan tyhjänä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany tu folder zachowuje swoje wiadomości; nowy folder jest tworzony pusty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная здесь папка сохраняет свои письма; новая папка создается пустой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана тут тека зберігає свої листи; нову теку створюють порожньою."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで選んだフォルダはメールを保持します。新しいフォルダは空で作成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此选择的文件夹保留其邮件；新文件夹创建时为空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此選擇的檔案夾保留其郵件；新檔案夾建立時為空。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 선택한 폴더는 메일을 유지하며, 새 폴더는 빈 상태로 만들어집니다."
          }
        }
      }
    },
